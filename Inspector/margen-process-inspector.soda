<soda version="2.0" name="journeys-cu01-gestionar-tramites">
    <!-- SODA-AGENT-HINT: Read <index> first, then read only the target line ranges -->
    <index>
        <entry kind="use" src="gestor-tramites-dependencias.soda" lines="9-9" />
