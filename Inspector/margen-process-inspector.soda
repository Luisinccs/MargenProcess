                <prop name="tramites-activos" value="${mocks.cu01_freemium_activos_tope}" />
                <prop name="latentes-contador" value="0" />
                <prop name="latentes-colapsado" value="true" />
                <prop name="tramites-latentes" value="[]" />
            </preview>
            <preview id="p-free-modal-nuevo" label="2. Formulario Nuevo Trámite (M01)" scene="M01-formulario-tramite" role="overlay" overlay="bottom-sheet" x="540" y="64" breakpoint="mobile" orientation="portrait">
                <prop name="titulo-modal" value="Nuevo Trámite" />
                <prop name="titulo-valor" value="Certificado Antecedentes Penales" />
                <prop name="categoria-valor" value="Migración y Residencia" />
