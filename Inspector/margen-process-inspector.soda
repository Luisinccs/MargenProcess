            </preview>
            <preview id="p-free-paywall" label="3. Paywall Personal Pro (M06)" scene="M06-paywall-contextual-personal-pro" role="overlay" overlay="bottom-sheet" x="1020" y="64" breakpoint="mobile" orientation="portrait">
                <prop name="motivo-titulo" value="Alcanzaste el límite de trámites gratuitos" />
                <prop name="motivo-subtitulo" value="Actualiza a Personal Pro para gestionar trámites ilimitados, plantillas completas y respaldos cifrados." />
                <prop name="modalidad-seleccionada" value="lifetime" />
                <prop name="precio-lifetime" value="$29.00" />
                <prop name="precio-anual" value="$12.00/a" />
            </preview>
            <segue from="p-free-panel" on="onNewTramite" to="p-free-modal-nuevo" />
            <segue from="p-free-modal-nuevo" on="onClose" action="dismiss" />
            <segue from="p-free-modal-nuevo" on="onCancel" action="dismiss" />
            <segue from="p-free-modal-nuevo" on="onConfirm" to="p-free-paywall" />
            <segue from="p-free-paywall" on="onClose" action="dismiss" />
            <segue from="p-free-paywall" on="onDismissPaywall" action="dismiss" />
            <segue from="p-free-paywall" on="onPurchasePro" to="p-free-panel" toast="Personal Pro activado. Trámite creado." />
        </journey>
        <journey name="journey-cu01-estado-vacio-mobile-portrait" title="CU-01 (Estado Vacío): Creación del Primer Trámite" initial-preview="p-empty-panel" width="393" height="852" description="Estado inicial sin trámites registrados en P01, apertura de M01 para crear el primer trámite y transición al panel poblado.">
