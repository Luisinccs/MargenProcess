        <icon name="zoom-in" viewBox="0 0 24 24" />
        <icon name="arrow-left" viewBox="0 0 24 24" />
        <icon name="x" viewBox="0 0 24 24" />
        <icon name="settings" viewBox="0 0 24 24" />
        <icon name="download" viewBox="0 0 24 24" />
        <icon name="rotate-ccw" viewBox="0 0 24 24" />
        <icon name="crown" viewBox="0 0 24 24" />
        <icon name="shield-check" viewBox="0 0 24 24" />
    </icon-defs>

    <group name="Elementos" collapsed="true">
        <component name="fila-tramite" role="element" design-width="360" design-height="96" description="Tarjeta o fila de trámite activo o latente en el panel principal">
            <props>
                <prop name="titulo" type="text" default="Seguro Vehicular" description="Título del trámite" />
                <prop name="categoria" type="text" default="Vehículos" description="Categoría del trámite" />
                <prop name="estado" type="enum" default="en-ventana" description="Estado del trámite" options="en-ventana,en-riesgo,completado,en-espera" />
                <prop name="proximo-paso" type="text" default="Reunir póliza y cédula" description="Próximo paso crítico" />
                <prop name="tiempo-restante" type="text" default="En 9 días" description="Cuenta regresiva o fecha" />
                <prop name="es-latente" type="boolean" default="false" description="Atenúa la tarjeta cuando el trámite está en espera/latente" />
            </props>
            <events>
                <event name="onSelect" description="Abre el detalle del trámite (P02)" />
            </events>
            <states>
                <when prop="estado" is="en-riesgo">
                <set target="badge-estado" bg="status-urgent-bg" />
                <set target="ico-estado" name="alert-triangle" color="status-urgent" />
                <set target="txt-estado" text="En riesgo" color="status-urgent" />
                <set target="txt-tiempo" color="status-urgent" />
                </when>
                <when prop="estado" is="completado">
                <set target="badge-estado" bg="status-ok-bg" />
                <set target="ico-estado" name="check-circle-2" color="status-ok" />
                <set target="txt-estado" text="Completado" color="status-ok" />
                <set target="txt-tiempo" color="status-ok" />
                </when>
                <when prop="estado" is="en-espera">
                <set target="badge-estado" bg="status-latent-bg" />
                <set target="ico-estado" name="hourglass" color="status-latent" />
                <set target="txt-estado" text="En espera / latente" color="status-latent" />
                <set target="txt-tiempo" color="text-muted" />
                </when>
                <when prop="es-latente" is="true">
                <set target="card-tramite" bg="bg-latent-card" opacity="0.78" />
                <set target="txt-titulo" color="text-muted" />
                </when>
            </states>
            <layout id="card-tramite" direction="vertical" width="fill" height="hug" padding="sm" gap="xs" bg="bg-surface" border="subtle" border-color="border-subtle" radius="md" action="onSelect" hover-bg="bg-surface-subtle" cursor="pointer">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="xs">
                    <ui-text id="txt-titulo" text="${titulo}" font="card-title" color="text-primary" multiline="true"></ui-text>
                    <ui-frame id="badge-estado" direction="horizontal" align="center" padding-x="xs" padding-y="xxs" gap="xxs" bg="status-warning-bg" radius="pill">
                        <ui-icon id="ico-estado" name="calendar-clock" color="status-warning" size="icon-sm" />
                        <ui-text id="txt-estado" text="En ventana de acción" font="badge" color="status-warning"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="xs">
                    <ui-text id="txt-paso" text="Próx. paso: ${proximo-paso}" font="caption" color="text-secondary" multiline="true"></ui-text>
                    <ui-text id="txt-tiempo" text="${tiempo-restante}" font="num-row" color="brand-accent"></ui-text>
                </ui-frame>
                <ui-text text="${categoria}" font="badge" color="text-muted"></ui-text>
            </layout>
        </component>

        <component name="campo-entrada" role="element" design-width="360" design-height="76" description="Campo de texto o valor con etiqueta, validación y mensaje de error">
            <props>
                <prop name="etiqueta" type="text" default="Título" description="Etiqueta del campo" />
                <prop name="valor" type="text" default="" description="Valor actual del campo" />
                <prop name="placeholder" type="text" default="Escribe aquí..." description="Texto guía" />
                <prop name="requerido" type="boolean" default="false" description="Indica si es obligatorio" />
                <prop name="estado-campo" type="enum" default="normal" description="Estado visual del campo" options="normal,focused,error" />
                <prop name="texto-error" type="text" default="Este campo es obligatorio" description="Mensaje de error" />
            </props>
            <events>
                <event name="onChange" description="Disparado al cambiar el valor del campo" />
            </events>
            <states>
                <when prop="estado-campo" is="focused">
                <set target="box-campo" border-color="brand-primary" border-width="2px" />
                </when>
                <when prop="estado-campo" is="error">
                <set target="lbl-campo" color="text-error" />
                <set target="box-campo" border-color="text-error" border-width="2px" />
                <set target="txt-error" visible="true" color="text-error" />
                </when>
            </states>
            <layout direction="vertical" width="fill" height="hug" gap="xxs">
                <ui-frame direction="horizontal" align="center" gap="xxs">
                    <ui-text id="lbl-campo" text="${etiqueta}" font="label" color="text-primary"></ui-text>
                    <ui-text text="*" font="label" color="text-error" visible="${requerido}"></ui-text>
                </ui-frame>
                <ui-frame id="box-campo" direction="horizontal" align="center" justify="space-between" width="fill" height="field-height" padding-x="sm" bg="bg-surface-elevated" border="strong" border-color="border-strong" radius="control" action="onChange" cursor="text">
                    <ui-text text="${valor}" font="body" color="text-primary" visible="true"></ui-text>
                </ui-frame>
                <ui-text id="txt-error" text="${texto-error}" font="caption" color="text-error" visible="false"></ui-text>
            </layout>
        </component>

        <component name="card-recaudo" role="element" design-width="360" design-height="92" description="Ítem de recaudo con alternancia Listo/Pendiente y acceso a adjuntos">
            <props>
                <prop name="nombre" type="text" default="Copia de cédula de identidad" description="Nombre del recaudo" />
                <prop name="estado" type="enum" default="pendiente" description="Estado del recaudo" options="pendiente,listo" />
                <prop name="archivo-nombre" type="text" default="cedula_frente.jpg" description="Nombre del archivo adjunto" />
                <prop name="tiene-adjunto" type="boolean" default="false" description="Indica si tiene archivo vinculado" />
            </props>
            <events>
                <event name="onToggleEstado" description="Alterna entre Pendiente y Listo" />
                <event name="onAdjuntar" description="Abre selector de origen de archivo (M04)" />
                <event name="onVerArchivo" description="Abre visor integrado de documentos (P04)" />
            </events>
            <states>
                <when prop="estado" is="listo">
                <set target="ico-check" name="check-circle-2" color="status-ok" />
                <set target="badge-recaudo" bg="status-ok-bg" />
                <set target="txt-recaudo" text="Listo" color="status-ok" />
                </when>
                <when prop="tiene-adjunto" is="true">
                <set target="btn-ver-adjunto" visible="true" />
                <set target="txt-sin-adjunto" visible="false" />
                </when>
            </states>
            <layout direction="vertical" width="fill" height="hug" padding="sm" gap="xs" bg="bg-surface-subtle" border="subtle" border-color="border-subtle" radius="md">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="xs">
                    <ui-frame direction="horizontal" align="center" flex="1" gap="xs" action="onToggleEstado" cursor="pointer">
                        <ui-icon id="ico-check" name="check" color="status-warning" size="icon-md" />
                        <ui-text text="${nombre}" font="label" color="text-primary" multiline="true"></ui-text>
                    </ui-frame>
                    <ui-frame id="badge-recaudo" direction="horizontal" align="center" padding-x="xs" padding-y="xxs" bg="status-warning-bg" radius="pill" action="onToggleEstado" cursor="pointer">
                        <ui-text id="txt-recaudo" text="Pendiente" font="badge" color="status-warning"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="xs">
                    <ui-frame id="btn-ver-adjunto" direction="horizontal" align="center" padding-x="xs" padding-y="xxs" gap="xxs" bg="brand-accent-soft" radius="sm" action="onVerArchivo" cursor="pointer" visible="false">
                        <ui-icon name="eye" color="brand-accent" size="icon-sm" />
                        <ui-text text="${archivo-nombre}" font="num-row" color="brand-accent"></ui-text>
                    </ui-frame>
                    <ui-text id="txt-sin-adjunto" text="Sin archivos adjuntos" font="caption" color="text-muted"></ui-text>
                    <ui-frame direction="horizontal" align="center" padding-x="xs" padding-y="xxs" gap="xxs" bg="bg-surface" border="subtle" border-color="border-strong" radius="sm" action="onAdjuntar" cursor="pointer">
                        <ui-icon name="paperclip" color="brand-primary" size="icon-sm" />
                        <ui-text text="Adjuntar" font="badge" color="brand-primary"></ui-text>
                    </ui-frame>
                </ui-frame>
            </layout>
        </component>

        <component name="barra-superior" role="element" design-width="393" design-height="56" description="Barra superior de navegación para pantallas completas y vistas operativas">
            <props>
                <prop name="titulo" type="text" default="Mis Trámites" description="Título de la vista" />
                <prop name="subtitulo" type="text" default="" description="Contexto o trámite activo" />
                <prop name="mostrar-volver" type="boolean" default="false" description="Muestra botón volver" />
                <prop name="mostrar-cerrar" type="boolean" default="false" description="Muestra botón cerrar" />
                <prop name="mostrar-config" type="boolean" default="false" description="Muestra acceso a configuración (P07)" />
                <prop name="mostrar-offline" type="boolean" default="false" description="Muestra indicador Offline listo" />
            </props>
            <events>
                <event name="onVolver" description="Regresa a la vista anterior" />
                <event name="onCerrar" description="Cierra modal o visor" />
                <event name="onConfig" description="Abre Configuración y Respaldo (P07)" />
            </events>
            <layout direction="horizontal" align="center" justify="space-between" width="fill" height="topbar-height" padding-x="md" gap="xs" bg="bg-surface" border-color="border-subtle" border-bottom="subtle">
                <ui-frame direction="horizontal" align="center" flex="1" gap="xs">
                    <ui-frame direction="horizontal" align="center" justify="center" padding="xxs" radius="control" action="onVolver" cursor="pointer" visible="${mostrar-volver}">
                        <ui-icon name="arrow-left" color="text-primary" size="icon-lg" />
                    </ui-frame>
                    <ui-frame direction="vertical" gap="none">
                        <ui-text text="${titulo}" font="screen-title" color="text-primary"></ui-text>
                        <ui-text text="${subtitulo}" font="caption" color="text-muted" visible="true"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" gap="xs">
                    <ui-frame direction="horizontal" align="center" padding-x="xs" padding-y="xxs" gap="xxs" bg="status-ok-bg" radius="pill" visible="${mostrar-offline}">
                        <ui-icon name="wifi-off" color="status-ok" size="icon-sm" />
                        <ui-text text="Offline" font="badge" color="status-ok"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" justify="center" padding="xs" bg="bg-surface-subtle" radius="control" action="onConfig" cursor="pointer" visible="${mostrar-config}">
                        <ui-icon name="settings" color="text-primary" size="icon-md" />
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" justify="center" padding="xs" bg="bg-surface-subtle" radius="control" action="onCerrar" cursor="pointer" visible="${mostrar-cerrar}">
                        <ui-icon name="x" color="text-primary" size="icon-md" />
                    </ui-frame>
                </ui-frame>
            </layout>
        </component>

        <component name="tab-estado-recaudo" role="element" design-width="120" design-height="36" description="Pestaña o píldora seleccionable de estado o modalidad">
            <props>
                <prop name="etiqueta" type="text" default="Todos" description="Texto de la pestaña" />
                <prop name="activo" type="boolean" default="false" description="Indica si está seleccionada" />
                <prop name="variante" type="enum" default="primario" description="Variante cromática" options="primario,pro" />
            </props>
            <events>
                <event name="onSelect" description="Selecciona la pestaña" />
            </events>
            <states>
                <when prop="activo" is="true">
                <set target="tab-pill" bg="brand-primary" border-color="brand-primary" />
                <set target="txt-tab" color="text-inverse" />
                </when>
                <when prop="variante" is="pro">
                <set target="tab-pill" bg="pro-accent-bg" border-color="pro-accent" />
                <set target="txt-tab" color="pro-accent" />
                </when>
            </states>
            <layout id="tab-pill" direction="horizontal" align="center" justify="center" height="36px" padding-x="sm" bg="bg-surface" border="subtle" border-color="border-subtle" radius="pill" action="onSelect" cursor="pointer">
                <ui-text id="txt-tab" text="${etiqueta}" font="badge" color="text-secondary"></ui-text>
            </layout>
        </component>
    </group>

    <group name="Bloques" collapsed="false">
        <component name="formulario-tramite" role="block" design-width="360" design-height="360" description="Bloque de formulario para crear o editar un trámite">
            <props>
                <prop name="titulo-modal" type="text" default="Nuevo Trámite" description="Encabezado del formulario" />
                <prop name="titulo-tramite" type="text" default="" description="Título del trámite" />
                <prop name="categoria" type="text" default="Migración" description="Categoría seleccionada" />
                <prop name="fecha-limite" type="text" default="15/05/2027" description="Fecha límite final" />
                <prop name="notas" type="text" default="" description="Notas generales" />
            </props>
            <events>
                <event name="onGuardar" description="Guarda los datos del trámite" />
                <event name="onCancelar" description="Cancela la operación" />
            </events>
            <layout direction="vertical" width="fill" height="hug" gap="md">
                <ui-frame direction="vertical" width="fill" gap="xs">
                    <ui-text text="Título" font="label" color="text-primary"></ui-text>
                    <ui-frame direction="horizontal" align="center" width="fill" height="field-height" padding-x="sm" bg="bg-surface-elevated" border="strong" border-color="border-strong" radius="control">
                        <ui-text text="${titulo-tramite}" font="body" color="text-primary"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="horizontal" width="fill" gap="sm">
                    <ui-frame direction="vertical" flex="1" gap="xs">
                        <ui-text text="Categoría" font="label" color="text-primary"></ui-text>
                        <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" height="field-height" padding-x="sm" bg="bg-surface-elevated" border="subtle" border-color="border-strong" radius="control">
                            <ui-text text="${categoria}" font="body" color="text-primary"></ui-text>
                        </ui-frame>
                    </ui-frame>
                    <ui-frame direction="vertical" flex="1" gap="xs">
                        <ui-text text="Fecha límite final" font="label" color="text-primary"></ui-text>
                        <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" height="field-height" padding-x="sm" bg="bg-surface-elevated" border="subtle" border-color="border-strong" radius="control">
                            <ui-text text="${fecha-limite}" font="num-row" color="text-primary"></ui-text>
                            <ui-icon name="calendar-clock" color="brand-primary" size="icon-sm" />
                        </ui-frame>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="vertical" width="fill" gap="xs">
                    <ui-text text="Notas generales" font="label" color="text-primary"></ui-text>
                    <ui-frame direction="vertical" width="fill" padding="sm" bg="bg-surface-elevated" border="subtle" border-color="border-subtle" radius="control">
                        <ui-text text="${notas}" font="body" color="text-secondary" multiline="true"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="md" bg="bg-surface-subtle" border="subtle" border-color="border-subtle" radius="control" action="onCancelar" cursor="pointer">
                        <ui-text text="Cancelar" font="label" color="text-primary"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="md" bg="brand-primary" radius="control" action="onGuardar" cursor="pointer">
                        <ui-text text="Guardar" font="label" color="text-inverse"></ui-text>
                    </ui-frame>
                </ui-frame>
            </layout>
        </component>

        <component name="coleccion-recaudos" role="block" design-width="360" design-height="280" description="Colección iterativa de recaudos del paso previo o taquilla">
            <props>
                <prop name="recaudos" type="list" default="[]" description="Lista de recaudos del paso" />
                <prop name="avance-texto" type="text" default="1/2 listos" description="Resumen de avance" />
            </props>
            <events>
                <event name="onToggleRecaudo" description="Alterna estado de un recaudo" />
                <event name="onAdjuntarRecaudo" description="Adjunta archivo a un recaudo" />
                <event name="onVerAdjunto" description="Abre visor para el archivo del recaudo" />
            </events>
            <layout direction="vertical" width="fill" height="hug" gap="sm">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill">
                    <ui-text text="RECAUDOS DEL PASO" font="badge" color="text-muted"></ui-text>
                    <ui-text text="${avance-texto}" font="num-row" color="brand-primary"></ui-text>
                </ui-frame>
                <ui-repeat items="${recaudos}" as="item">
                    <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" padding="sm" gap="xs" bg="bg-surface-subtle" border="subtle" border-color="border-subtle" radius="md">
                        <ui-frame direction="vertical" flex="1" gap="xxs" action="onToggleRecaudo" cursor="pointer">
                            <ui-text text="${item.nombre}" font="label" color="text-primary" multiline="true"></ui-text>
                            <ui-text text="${item.archivo}" font="caption" color="brand-accent"></ui-text>
                        </ui-frame>
                        <ui-frame direction="horizontal" align="center" padding-x="xs" padding-y="xxs" bg="status-ok-bg" radius="pill" action="onToggleRecaudo" cursor="pointer">
                            <ui-text text="${item.estado}" font="badge" color="status-ok"></ui-text>
                        </ui-frame>
                    </ui-frame>
                </ui-repeat>
            </layout>
        </component>
    </group>

    <scene name="panel-principal" target="window" description="P01 - Panel Principal de Trámites con ruta crítica, activos y latentes">
        <props>
            <prop name="ruta-critica-titulo" type="text" default="Renovar Pasaporte" description="Trámite en ruta crítica" />
            <prop name="ruta-critica-paso" type="text" default="Solicitar cita consular" description="Próximo paso crítico" />
            <prop name="ruta-critica-plazo" type="text" default="Vence paso en 4 días · Límite: 15/05/2027" description="Plazo de ruta crítica" />
            <prop name="tramites-activos" type="list" default="[]" description="Lista de trámites activos" />
            <prop name="tramites-latentes" type="list" default="[]" description="Lista de trámites en espera/latentes" />
            <prop name="latentes-visibles" type="boolean" default="true" description="Expande o colapsa trámites latentes" />
        </props>
        <events>
            <event name="onAbrirDetalle" description="Abre P02" />
            <event name="onNuevoTramite" description="Abre M01" />
            <event name="onDesdePlantilla" description="Abre P06" />
            <event name="onAbrirConfig" description="Abre P07" />
            <event name="onToggleLatentes" description="Alterna visibilidad de trámites latentes" />
        </events>
        <states>
            <when prop="latentes-visibles" is="false">
            <set target="lista-latentes" visible="false" />
            </when>
        </states>
        <layout direction="vertical" width="fill" height="fill" bg="bg-page">
            <barra-superior titulo="Mis Trámites" mostrar-config="true" onConfig="onAbrirConfig" />
            <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="md" gap="md">
                <ui-frame direction="vertical" width="fill" padding="md" gap="xs" bg="bg-surface" border="strong" border-color="status-urgent" radius="md" action="onAbrirDetalle" cursor="pointer">
                    <ui-frame direction="horizontal" align="center" justify="space-between" width="fill">
                        <ui-frame direction="horizontal" align="center" padding-x="xs" padding-y="xxs" gap="xxs" bg="status-urgent-bg" radius="pill">
                            <ui-icon name="alert-triangle" color="status-urgent" size="icon-sm" />
                            <ui-text text="PRÓXIMO PASO CRÍTICO" font="badge" color="status-urgent"></ui-text>
                        </ui-frame>
                        <ui-icon name="calendar-clock" color="status-urgent" size="icon-md" />
                    </ui-frame>
                    <ui-text text="${ruta-critica-titulo} → ${ruta-critica-paso}" font="card-title" color="text-primary" multiline="true"></ui-text>
                    <ui-text text="${ruta-critica-plazo}" font="num-row" color="status-urgent"></ui-text>
                </ui-frame>
                <ui-frame direction="vertical" width="fill" gap="xs">
                    <ui-text text="ACTIVOS" font="badge" color="text-muted"></ui-text>
                    <ui-repeat items="${tramites-activos}" as="item">
                        <ui-frame direction="vertical" width="fill" padding="sm" gap="xxs" bg="bg-surface" border="subtle" border-color="border-subtle" radius="md" action="onAbrirDetalle" cursor="pointer">
                            <ui-frame direction="horizontal" align="center" justify="space-between" width="fill">
                                <ui-text text="${item.titulo}" font="label" color="text-primary"></ui-text>
                                <ui-text text="${item.estado}" font="badge" color="status-warning"></ui-text>
                            </ui-frame>
                            <ui-text text="${item.paso} · ${item.plazo}" font="num-row" color="text-secondary"></ui-text>
                        </ui-frame>
                    </ui-repeat>
                </ui-frame>
                <ui-frame direction="vertical" width="fill" gap="xs">
                    <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" action="onToggleLatentes" cursor="pointer">
                        <ui-text text="EN ESPERA / LATENTES" font="badge" color="status-latent"></ui-text>
                        <ui-icon name="hourglass" color="status-latent" size="icon-sm" />
                    </ui-frame>
                    <ui-frame id="lista-latentes" direction="vertical" width="fill" gap="xs">
                        <ui-repeat items="${tramites-latentes}" as="lat">
                            <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" padding="sm" bg="bg-latent-card" border="subtle" border-color="border-subtle" radius="md" opacity="0.78" action="onAbrirDetalle" cursor="pointer">
                                <ui-text text="${lat.titulo}" font="body" color="text-muted"></ui-text>
                                <ui-text text="${lat.plazo}" font="num-row" color="text-muted"></ui-text>
                            </ui-frame>
                        </ui-repeat>
                    </ui-frame>
                </ui-frame>
            </ui-frame>
            <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" padding="md" gap="sm" bg="bg-surface" border-color="border-subtle" border-top="subtle">
                <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="sm" gap="xxs" bg="bg-surface-subtle" border="subtle" border-color="border-subtle" radius="control" action="onDesdePlantilla" cursor="pointer">
                    <ui-icon name="copy-plus" color="brand-primary" size="icon-md" />
                    <ui-text text="Desde plantilla" font="label" color="text-primary"></ui-text>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="sm" gap="xxs" bg="brand-primary" radius="control" action="onNuevoTramite" cursor="pointer">
                    <ui-icon name="plus" color="text-inverse" size="icon-md" />
                    <ui-text text="Nuevo Trámite" font="label" color="text-inverse"></ui-text>
                </ui-frame>
            </ui-frame>
        </layout>
    </scene>

    <scene name="detalle-tramite" target="window" description="P02 - Detalle del Trámite, cuenta regresiva, taquilla y cadena de pasos previos">
        <props>
            <prop name="titulo" type="text" default="Renovar Pasaporte" description="Nombre del trámite" />
            <prop name="categoria" type="text" default="Migración" description="Categoría" />
            <prop name="estado" type="text" default="En ventana de acción" description="Estado actual" />
            <prop name="fecha-limite" type="text" default="15/05/2027" description="Fecha límite final" />
            <prop name="dias-restantes" type="text" default="176d" description="Cuenta regresiva principal" />
            <prop name="notas" type="text" default="Verificar vigencia mínima de 6 meses." description="Notas generales" />
            <prop name="pasos" type="list" default="[]" description="Secuencia de pasos previos" />
        </props>
        <events>
            <event name="onVolver" description="Vuelve a P01" />
            <event name="onEditar" description="Abre M01 en modo edición" />
            <event name="onEliminar" description="Abre M02 de confirmación" />
            <event name="onAbrirTaquilla" description="Abre Vista Rápida de Taquilla (P05)" />
            <event name="onAgregarPaso" description="Abre M03 para agregar paso previo" />
            <event name="onAbrirPaso" description="Abre P03 para gestionar recaudos del paso" />
        </events>
        <layout direction="vertical" width="fill" height="fill" bg="bg-page">
            <barra-superior titulo="${titulo}" subtitulo="${categoria} · ${estado}" mostrar-volver="true" onVolver="onVolver" />
            <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="md" gap="md">
                <ui-frame direction="vertical" width="fill" padding="md" gap="xs" bg="bg-surface" border="subtle" border-color="border-subtle" radius="md">
                    <ui-frame direction="horizontal" align="center" justify="space-between" width="fill">
                        <ui-text text="Límite: ${fecha-limite}" font="num-row" color="text-secondary"></ui-text>
                        <ui-text text="${dias-restantes}" font="display-hero" color="brand-accent"></ui-text>
                    </ui-frame>
                    <ui-text text="${notas}" font="body" color="text-secondary" multiline="true"></ui-text>
                    <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="xs">
                        <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" gap="xxs" bg="bg-surface-subtle" border="subtle" border-color="border-subtle" radius="control" action="onEditar" cursor="pointer">
                            <ui-icon name="pencil" color="text-primary" size="icon-sm" />
                            <ui-text text="Editar" font="label" color="text-primary"></ui-text>
                        </ui-frame>
                        <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" gap="xxs" bg="status-urgent-bg" radius="control" action="onEliminar" cursor="pointer">
                            <ui-icon name="trash-2" color="status-urgent" size="icon-sm" />
                            <ui-text text="Eliminar" font="label" color="status-urgent"></ui-text>
                        </ui-frame>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" padding="md" bg="brand-accent-soft" border="subtle" border-color="brand-accent" radius="md" action="onAbrirTaquilla" cursor="pointer">
                    <ui-frame direction="horizontal" align="center" gap="xs">
                        <ui-icon name="briefcase" color="brand-accent" size="icon-md" />
                        <ui-text text="Listo para cita / taquilla (Offline)" font="label" color="brand-accent"></ui-text>
                    </ui-frame>
                    <ui-icon name="wifi-off" color="brand-accent" size="icon-sm" />
                </ui-frame>
                <ui-frame direction="vertical" width="fill" gap="xs">
                    <ui-frame direction="horizontal" align="center" justify="space-between" width="fill">
                        <ui-text text="PASOS PREVIOS Y DEPENDENCIAS" font="badge" color="text-muted"></ui-text>
                        <ui-frame direction="horizontal" align="center" padding-x="xs" padding-y="xxs" gap="xxs" bg="brand-primary" radius="control" action="onAgregarPaso" cursor="pointer">
                            <ui-icon name="list-plus" color="text-inverse" size="icon-sm" />
                            <ui-text text="Agregar paso" font="badge" color="text-inverse"></ui-text>
                        </ui-frame>
                    </ui-frame>
                    <ui-repeat items="${pasos}" as="paso">
                        <ui-frame direction="vertical" width="fill" padding="sm" gap="xxs" bg="bg-surface" border="subtle" border-color="border-subtle" radius="md" action="onAbrirPaso" cursor="pointer">
                            <ui-frame direction="horizontal" align="center" justify="space-between" width="fill">
                                <ui-frame direction="horizontal" align="center" gap="xs">
                                    <ui-icon name="git-commit-vertical" color="brand-accent" size="icon-md" />
                                    <ui-text text="${paso.nombre}" font="label" color="text-primary"></ui-text>
                                </ui-frame>
                                <ui-text text="${paso.fecha}" font="num-row" color="brand-accent"></ui-text>
                            </ui-frame>
                            <ui-text text="Anticipación: ${paso.anticipacion} · Recaudos: ${paso.recaudos}" font="caption" color="text-secondary"></ui-text>
                        </ui-frame>
                    </ui-repeat>
                </ui-frame>
            </ui-frame>
        </layout>
    </scene>

    <scene name="modal-formulario-tramite" target="window" description="M01 - Modal / Bottom Sheet para crear o editar un trámite">
        <props>
            <prop name="titulo-modal" type="text" default="Nuevo Trámite" description="Título del modal" />
            <prop name="titulo-tramite" type="text" default="" description="Nombre del trámite" />
            <prop name="categoria" type="text" default="Migración" description="Categoría" />
            <prop name="fecha-limite" type="text" default="15/05/2027" description="Fecha límite" />
            <prop name="notas" type="text" default="" description="Notas" />
        </props>
        <events>
            <event name="onCerrar" description="Cierra el modal" />
            <event name="onGuardar" description="Guarda y cierra" />
            <event name="onCancelar" description="Cancela y cierra" />
        </events>
        <layout direction="vertical" width="fill" height="hug" padding="lg" gap="md" bg="bg-surface-elevated" border="subtle" border-color="border-strong" radius="sheet">
            <barra-superior titulo="${titulo-modal}" mostrar-cerrar="true" onCerrar="onCerrar" />
            <formulario-tramite titulo-modal="${titulo-modal}" titulo-tramite="${titulo-tramite}" categoria="${categoria}" fecha-limite="${fecha-limite}" notas="${notas}" onGuardar="onGuardar" onCancelar="onCancelar" />
        </layout>
    </scene>

    <scene name="modal-paywall-pro" target="window" description="M06 - Paywall contextual para desbloquear Personal Pro (Lifetime / Anual)">
        <props>
            <prop name="motivo" type="text" default="Amplía tus límites, accede a todas las plantillas y exporta respaldos completos." description="Motivo contextual de activación" />
            <prop name="plan-seleccionado" type="enum" default="lifetime" description="Modalidad de plan seleccionada" options="lifetime,anual" />
            <prop name="procesando" type="boolean" default="false" description="Estado de procesamiento de compra o restauración" />
        </props>
        <events>
            <event name="onCerrar" description="Descarta el paywall" />
            <event name="onSeleccionarPlan" description="Cambia entre Pago único Lifetime y Suscripción anual" />
            <event name="onComprar" description="Inicia compra del plan seleccionado" />
            <event name="onRestaurar" description="Restaura compras previas" />
        </events>
        <states>
            <when prop="plan-seleccionado" is="anual">
            <set target="tab-lifetime" activo="false" />
            <set target="tab-anual" activo="true" variante="pro" />
            </when>
        </states>
        <layout direction="vertical" width="fill" height="hug" padding="lg" gap="md" bg="bg-surface-elevated" border="strong" border-color="pro-accent" radius="sheet">
            <barra-superior titulo="Desbloquea Personal Pro" mostrar-cerrar="true" onCerrar="onCerrar" />
            <ui-frame direction="horizontal" align="center" padding="sm" gap="xs" bg="pro-accent-bg" radius="md">
                <ui-icon name="crown" color="pro-accent" size="icon-md" />
                <ui-text text="${motivo}" font="body" color="text-primary" multiline="true"></ui-text>
            </ui-frame>
            <ui-frame direction="horizontal" align="center" width="fill" gap="xs">
                <tab-estado-recaudo id="tab-lifetime" flex="1" etiqueta="Pago único Lifetime" activo="true" variante="pro" onSelect="onSeleccionarPlan" />
                <tab-estado-recaudo id="tab-anual" flex="1" etiqueta="Suscripción anual" activo="false" onSelect="onSeleccionarPlan" />
            </ui-frame>
            <ui-frame direction="horizontal" align="center" gap="xs">
                <ui-icon name="shield-check" color="status-ok" size="icon-sm" />
                <ui-text text="Respaldo cifrado local y restauración nativa incluidos" font="caption" color="text-secondary"></ui-text>
            </ui-frame>
            <ui-frame direction="horizontal" align="center" justify="center" width="fill" height="field-height" gap="xs" bg="pro-accent" radius="control" action="onComprar" cursor="pointer">
                <ui-icon name="crown" color="text-inverse" size="icon-sm" />
                <ui-text text="Continuar / Comprar" font="label" color="text-inverse"></ui-text>
            </ui-frame>
            <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" gap="xxs" bg="bg-surface-subtle" border="subtle" border-color="border-subtle" radius="control" action="onRestaurar" cursor="pointer">
                    <ui-icon name="rotate-ccw" color="text-primary" size="icon-sm" />
                    <ui-text text="Restaurar compras" font="label" color="text-primary"></ui-text>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" bg="bg-surface-subtle" border="subtle" border-color="border-subtle" radius="control" action="onCerrar" cursor="pointer">
                    <ui-text text="Ahora no" font="label" color="text-muted"></ui-text>
                </ui-frame>
            </ui-frame>
        </layout>
    </scene>
</soda>
