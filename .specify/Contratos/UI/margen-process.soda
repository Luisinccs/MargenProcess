        <font name="num-row" font-size="num-sm" font-family="font-mono" font-weight="semibold" />
        <font name="caption" font-size="sm" font-family="font-sans" font-weight="medium" />
        <font name="badge" font-size="xs" font-family="font-sans" font-weight="semibold" />
        <spacing name="none" value="0px" />
        <spacing name="xxs" value="4px" />
        <spacing name="xs" value="8px" />
