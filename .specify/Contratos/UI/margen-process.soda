        <path d="m2 2 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="zoom-in" category="document" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <line x1="21" x2="16.65" y1="21" y2="16.65" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <line x1="11" x2="11" y1="8" y2="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <line x1="8" x2="14" y1="11" y2="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="zoom-out" category="document" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <line x1="21" x2="16.65" y1="21" y2="16.65" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <line x1="8" x2="14" y1="11" y2="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="arrow-left" category="navigation" viewBox="0 0 24 24">
        <path d="m12 19-7-7 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M19 12H5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="arrow-right" category="navigation" viewBox="0 0 24 24">
        <path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="m12 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="x" category="navigation" viewBox="0 0 24 24">
        <path d="M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="m6 6 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="chevron-down" category="navigation" viewBox="0 0 24 24">
        <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="settings" category="navigation" viewBox="0 0 24 24">
        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="download" category="action" viewBox="0 0 24 24">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <polyline points="7 10 12 15 17 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <line x1="12" x2="12" y1="15" y2="3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="rotate-ccw" category="action" viewBox="0 0 24 24">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M3 3v5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="crown" category="pro" viewBox="0 0 24 24">
        <path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M5 21h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
        <icon name="shield-check" category="security" viewBox="0 0 24 24">
        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="m9 12 2 2 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </icon>
    </icon-defs>

    <group name="Elementos" collapsed="true">
        <component name="barra-superior-navegacion" role="element" design-width="600" design-height="200" description="Barra superior estándar para pantallas principales y secundarias">
            <props>
                <prop name="titulo" type="text" default="Mis Trámites" description="Título principal de la barra" />
                <prop name="mostrar-volver" type="boolean" default="false" description="Muestra botón de retroceso" />
                <prop name="icono-accion-primaria" type="text" default="settings" description="Ícono de acción derecha" />
                <prop name="etiqueta-accion-primaria" type="text" default="" description="Texto opcional en botón derecho" />
                <prop name="mostrar-accion-secundaria" type="boolean" default="false" description="Muestra segunda acción derecha" />
                <prop name="icono-accion-secundaria" type="text" default="pencil" description="Ícono de segunda acción derecha" />
                <prop name="badge-texto" type="text" default="" description="Etiqueta de estado en cabecera (ej. Offline)" />
            </props>
            <events>
                <event name="onBack" description="Volver a la pantalla anterior" />
                <event name="onPrimaryAction" description="Acción principal de barra superior" />
                <event name="onSecondaryAction" description="Acción secundaria de barra superior" />
            </events>
            <states>
                <when prop="mostrar-volver" is="true">
                <set target="btn-back" visible="true" />
                </when>
                <when prop="mostrar-accion-secundaria" is="true">
                <set target="btn-secondary-action" visible="true" />
                </when>
                <when prop="etiqueta-accion-primaria" is-not="">
                <set target="btn-primary-label" visible="true" />
                </when>
                <when prop="badge-texto" is-not="">
                <set target="topbar-badge" visible="true" />
                </when>
            </states>
            <layout id="topbar-root" direction="horizontal" align="center" justify="space-between" width="fill" height="topbar-height" padding-x="lg" padding-y="sm" gap="sm" bg="bg-surface" border-bottom="border-subtle">
                <ui-frame id="topbar-left" direction="horizontal" align="center" flex="1" clip="true" gap="sm">
                    <ui-frame id="btn-back" direction="horizontal" align="center" justify="center" padding="xs" radius="sm" action="onBack" hover-bg="bg-surface-subtle" cursor="pointer" visible="false">
                        <ui-icon name="arrow-left" color="text-primary" size="md" />
                    </ui-frame>
                    <ui-text id="topbar-title" text="${titulo}" flex="1" font="screen-title" color="text-primary" max-lines="1"></ui-text>
                </ui-frame>
                <ui-frame id="topbar-right" direction="horizontal" align="center" gap="xs">
                    <ui-frame id="topbar-badge" direction="horizontal" align="center" padding-x="sm" padding-y="2xs" gap="2xs" bg="status-ok-bg" radius="pill" visible="false">
                        <ui-icon name="wifi-off" color="status-ok" size="sm" />
                        <ui-text id="topbar-badge-text" text="${badge-texto}" font="badge" color="status-ok"></ui-text>
                    </ui-frame>
                    <ui-frame id="btn-secondary-action" direction="horizontal" align="center" justify="center" padding="xs" radius="sm" action="onSecondaryAction" hover-bg="bg-surface-subtle" cursor="pointer" visible="false">
                        <ui-icon name="${icono-accion-secundaria}" color="text-secondary" size="md" />
                    </ui-frame>
                    <ui-frame id="btn-primary-action" direction="horizontal" align="center" justify="center" padding-x="sm" padding-y="xs" gap="2xs" radius="sm" action="onPrimaryAction" hover-bg="bg-surface-subtle" cursor="pointer">
                        <ui-icon name="${icono-accion-primaria}" color="text-primary" size="md" />
                        <ui-text id="btn-primary-label" text="${etiqueta-accion-primaria}" font="caption" color="text-primary" visible="false"></ui-text>
                    </ui-frame>
                </ui-frame>
            </layout>
        </component>

        <component name="encabezado-modal" role="element" design-width="600" design-height="200" description="Cabecera de modal o bottom sheet con título, subtítulo opcional y cierre">
            <props>
                <prop name="titulo" type="text" default="Nuevo Trámite" description="Título del modal" />
                <prop name="subtitulo" type="text" default="" description="Subtítulo o contexto del modal" />
            </props>
            <events>
                <event name="onClose" description="Cerrar o descartar modal" />
            </events>
            <states>
                <when prop="subtitulo" is-not="">
                <set target="modal-subtitle" visible="true" />
                </when>
            </states>
            <layout id="modal-header-root" direction="vertical" width="fill" padding-x="lg" padding-y="md" gap="2xs" bg="bg-surface-elevated" border-bottom="border-subtle">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-text text="${titulo}" flex="1" font="modal-title" color="text-primary"></ui-text>
                    <ui-frame direction="horizontal" align="center" justify="center" padding="xs" radius="sm" action="onClose" hover-bg="bg-surface-subtle" cursor="pointer">
                        <ui-icon name="x" color="text-secondary" size="md" />
                    </ui-frame>
                </ui-frame>
                <ui-text id="modal-subtitle" text="${subtitulo}" font="caption" color="text-secondary" multiline="true" visible="false"></ui-text>
            </layout>
        </component>

        <component name="badge-estado" role="element" design-width="600" design-height="200" description="Badge semántico de estado de trámite o recaudo">
            <props>
                <prop name="etiqueta" type="text" default="En ventana de acción" description="Texto del estado" />
                <prop name="variante" type="enum" default="warning" description="Variante cromática semántica" options="urgent,warning,ok,latent,pro,accent" />
                <prop name="icono" type="text" default="alert-triangle" description="Nombre del ícono en icon-defs" />
            </props>
            <states>
                <when prop="variante" is="urgent">
                <set target="badge-root" bg="status-urgent-bg" />
                <set target="badge-icon" color="status-urgent" />
                <set target="badge-text" color="status-urgent" />
                </when>
                <when prop="variante" is="warning">
                <set target="badge-root" bg="status-warning-bg" />
                <set target="badge-icon" color="status-warning" />
                <set target="badge-text" color="status-warning" />
                </when>
                <when prop="variante" is="ok">
                <set target="badge-root" bg="status-ok-bg" />
                <set target="badge-icon" color="status-ok" />
                <set target="badge-text" color="status-ok" />
                </when>
                <when prop="variante" is="latent">
                <set target="badge-root" bg="status-latent-bg" />
                <set target="badge-icon" color="status-latent" />
                <set target="badge-text" color="status-latent" />
                </when>
                <when prop="variante" is="pro">
                <set target="badge-root" bg="pro-accent-bg" />
                <set target="badge-icon" color="pro-accent" />
                <set target="badge-text" color="pro-accent" />
                </when>
                <when prop="variante" is="accent">
                <set target="badge-root" bg="brand-accent-soft" />
                <set target="badge-icon" color="brand-accent" />
                <set target="badge-text" color="brand-accent" />
                </when>
            </states>
            <layout id="badge-root" direction="horizontal" align="center" width="hug" padding-x="sm" padding-y="2xs" gap="2xs" bg="status-warning-bg" radius="pill">
                <ui-icon id="badge-icon" name="${icono}" color="status-warning" size="sm" />
                <ui-text id="badge-text" text="${etiqueta}" font="badge" color="status-warning"></ui-text>
            </layout>
        </component>

        <component name="bloque-ruta-critica" role="element" design-width="600" design-height="200" description="Tarjeta destacada del próximo paso crítico y cuenta regresiva en P01">
            <props>
                <prop name="estado-etiqueta" type="text" default="En riesgo" description="Etiqueta de urgencia o ventana" />
                <prop name="variante-estado" type="enum" default="urgent" description="Variante urgente o ventana" options="urgent,warning" />
                <prop name="tramite-titulo" type="text" default="Renovar Pasaporte" description="Nombre del trámite asociado" />
                <prop name="paso-critico" type="text" default="Solicitar cita consular" description="Título del próximo paso crítico" />
                <prop name="cuenta-paso" type="text" default="Vence paso en 4 días" description="Cuenta regresiva del paso crítico" />
                <prop name="fecha-limite" type="text" default="Límite final: 15/05/2027" description="Fecha límite final del trámite" />
                <prop name="etiqueta-accion" type="text" default="Ver" description="Texto de acción rápida" />
            </props>
            <events>
                <event name="onOpenCritical" description="Abrir trámite o paso crítico" />
            </events>
            <states>
                <when prop="variante-estado" is="warning">
                <set target="critical-card-root" border-color="status-warning" />
                <set target="critical-icon" color="status-warning" />
                <set target="critical-countdown" color="status-warning" />
                </when>
            </states>
            <layout id="critical-card-root" direction="vertical" width="fill" padding="lg" gap="sm" bg="bg-surface" border="strong" border-color="status-urgent" border-left="accent-bar" radius="md" action="onOpenCritical" hover-bg="bg-surface-subtle" cursor="pointer">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-frame direction="horizontal" align="center" gap="xs">
                        <ui-icon id="critical-icon" name="alert-triangle" color="status-urgent" size="md" />
                        <ui-text text="PRÓXIMO PASO CRÍTICO" font="badge" color="text-secondary"></ui-text>
                    </ui-frame>
                    <badge-estado id="critical-badge" etiqueta="${estado-etiqueta}" variante="${variante-estado}" icono="calendar-clock" />
                </ui-frame>
                <ui-frame direction="vertical" width="fill" gap="2xs">
                    <ui-text text="${tramite-titulo}" font="caption" color="text-secondary" max-lines="1"></ui-text>
                    <ui-text text="${paso-critico}" font="card-title" color="text-primary" multiline="true"></ui-text>
                </ui-frame>
                <ui-line direction="horizontal" width="fill" color="border-subtle" thickness="1px" />
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-frame direction="vertical" flex="1" gap="2xs">
                        <ui-text id="critical-countdown" text="${cuenta-paso}" font="metric-md" color="status-urgent"></ui-text>
                        <ui-text text="${fecha-limite}" font="metric-sm" color="text-secondary"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" padding-x="md" padding-y="sm" gap="2xs" bg="brand-primary" radius="sm" action="onOpenCritical" cursor="pointer">
                        <ui-text text="${etiqueta-accion}" font="caption" color="text-inverse" font-weight="bold"></ui-text>
                        <ui-icon name="arrow-right" color="text-inverse" size="sm" />
                    </ui-frame>
                </ui-frame>
            </layout>
        </component>

        <component name="tarjeta-tramite" role="element" design-width="600" design-height="200" description="Tarjeta o fila repetible de trámite activo o latente en P01">
            <props>
                <prop name="titulo" type="text" default="Seguro Vehicular" description="Título del trámite" />
                <prop name="categoria" type="text" default="Seguros y Vehículos" description="Categoría del trámite" />
                <prop name="estado-texto" type="text" default="En ventana de acción" description="Estado del trámite" />
                <prop name="variante-estado" type="enum" default="warning" description="Variante visual del estado" options="urgent,warning,ok,latent" />
                <prop name="detalle-secundario" type="text" default="Próx. paso: Reunir póliza y cédula · En 9 días" description="Próximo paso o ventana de apertura" />
                <prop name="progreso-texto" type="text" default="2/3 recaudos listos" description="Resumen de progreso" />
                <prop name="latente" type="boolean" default="false" description="Atenúa la tarjeta para trámites en espera/latentes" />
            </props>
            <events>
                <event name="onSelect" description="Seleccionar trámite para abrir Detalle P02" />
            </events>
            <states>
                <when prop="latente" is="true">
                <set target="tramite-card-root" bg="bg-latent-card" opacity="0.78" />
                <set target="tramite-titulo" color="text-secondary" />
                <set target="tramite-progreso" color="text-muted" />
                </when>
            </states>
            <layout id="tramite-card-root" direction="vertical" width="fill" padding="md" gap="sm" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md" action="onSelect" hover-bg="bg-surface-subtle" cursor="pointer">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-frame direction="vertical" flex="1" clip="true" gap="2xs">
                        <ui-text id="tramite-titulo" text="${titulo}" font="card-title" color="text-primary" max-lines="1"></ui-text>
                        <ui-text text="${categoria}" font="caption" color="text-muted" max-lines="1"></ui-text>
                    </ui-frame>
                    <badge-estado etiqueta="${estado-texto}" variante="${variante-estado}" icono="calendar-clock" />
                </ui-frame>
                <ui-text id="tramite-detalle" text="${detalle-secundario}" font="body" color="text-secondary" multiline="true"></ui-text>
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill">
                    <ui-text id="tramite-progreso" text="${progreso-texto}" font="metric-sm" color="brand-accent"></ui-text>
                    <ui-icon name="arrow-right" color="text-muted" size="sm" />
                </ui-frame>
            </layout>
        </component>

        <component name="item-paso-previo" role="element" design-width="600" design-height="200" description="Ítem de paso previo en secuencia con anticipación, fecha calculada y recaudos">
            <props>
                <prop name="orden" type="text" default="1" description="Número de secuencia del paso" />
                <prop name="nombre" type="text" default="Reunir recaudos base" description="Nombre del paso previo" />
                <prop name="anticipacion" type="text" default="2 semanas antes" description="Anticipación configurada" />
                <prop name="fecha-calculada" type="text" default="01/05/2027" description="Fecha límite o inicio calculada" />
                <prop name="resumen-recaudos" type="text" default="2/2 listos · 2 adjuntos" description="Conteo de recaudos y adjuntos" />
            </props>
            <events>
                <event name="onEditStep" description="Editar u ordenar el paso previo en M03" />
                <event name="onOpenStep" description="Abrir detalle del paso y recaudos en P03" />
            </events>
            <layout direction="vertical" width="fill" padding="md" gap="sm" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-frame direction="horizontal" align="center" flex="1" clip="true" gap="sm">
                        <ui-frame direction="horizontal" align="center" justify="center" width="28px" height="28px" bg="brand-accent-soft" radius="pill">
                            <ui-text text="${orden}" font="metric-sm" color="brand-accent"></ui-text>
                        </ui-frame>
                        <ui-text text="${nombre}" flex="1" font="card-title" color="text-primary" multiline="true"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" padding-x="sm" padding-y="xs" gap="2xs" bg="bg-surface-subtle" border="hairline" border-color="border-subtle" radius="sm" action="onEditStep" cursor="pointer">
                        <ui-icon name="pencil" color="text-secondary" size="sm" />
                        <ui-text text="Editar" font="caption" color="text-secondary"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="space-between" wrap="true" width="fill" gap="sm">
                    <ui-text text="${anticipacion}" font="caption" color="text-secondary"></ui-text>
                    <ui-text text="Fecha: ${fecha-calculada}" font="metric-sm" color="text-primary"></ui-text>
                </ui-frame>
                <ui-line direction="horizontal" width="fill" color="border-subtle" thickness="1px" />
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-text text="${resumen-recaudos}" flex="1" font="metric-sm" color="brand-primary"></ui-text>
                    <ui-frame direction="horizontal" align="center" padding-x="md" padding-y="xs" gap="2xs" bg="brand-primary" radius="sm" action="onOpenStep" cursor="pointer">
                        <ui-text text="Abrir" font="caption" color="text-inverse" font-weight="bold"></ui-text>
                        <ui-icon name="arrow-right" color="text-inverse" size="sm" />
                    </ui-frame>
                </ui-frame>
            </layout>
        </component>

        <component name="item-recaudo" role="element" design-width="600" design-height="200" description="Ítem de recaudo con estado Pendiente/Listo, adjuntos vinculados y acción de adjuntar">
            <props>
                <prop name="denominacion" type="text" default="Copia de cédula de identidad" description="Nombre del recaudo" />
                <prop name="listo" type="boolean" default="false" description="Indica si el recaudo está Listo o Pendiente" />
                <prop name="estado-texto" type="text" default="Pendiente" description="Etiqueta de estado del recaudo" />
                <prop name="archivo-nombre" type="text" default="" description="Nombre del archivo adjunto si existe" />
            </props>
            <events>
                <event name="onToggleReady" description="Alternar estado Pendiente / Listo" />
                <event name="onAttachFile" description="Abrir selector de origen M04 para adjuntar archivo" />
                <event name="onOpenViewer" description="Abrir visor P04 para el archivo adjunto" />
            </events>
            <states>
                <when prop="listo" is="true">
                <set target="recaudo-checkbox" bg="status-ok" border-color="status-ok" />
                <set target="recaudo-check-icon" visible="true" />
                <set target="recaudo-badge" variante="ok" icono="check-circle-2" />
                </when>
                <when prop="archivo-nombre" is-not="">
                <set target="recaudo-attachment-btn" visible="true" />
                <set target="recaudo-no-attachment" visible="false" />
                </when>
            </states>
            <layout id="recaudo-root" direction="vertical" width="fill" padding="md" gap="sm" bg="bg-surface-subtle" border="hairline" border-color="border-subtle" radius="md">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-frame id="recaudo-check-btn" direction="horizontal" align="center" flex="1" gap="sm" action="onToggleReady" cursor="pointer">
                        <ui-frame id="recaudo-checkbox" direction="horizontal" align="center" justify="center" width="22px" height="22px" bg="bg-surface" border="strong" border-color="border-strong" radius="sm">
                            <ui-icon id="recaudo-check-icon" name="check" color="text-inverse" size="sm" visible="false" />
                        </ui-frame>
                        <ui-text text="${denominacion}" flex="1" font="body" color="text-primary" multiline="true"></ui-text>
                    </ui-frame>
                    <badge-estado id="recaudo-badge" etiqueta="${estado-texto}" variante="warning" icono="alert-triangle" />
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-frame id="recaudo-attachment-btn" direction="horizontal" align="center" flex="1" gap="xs" action="onOpenViewer" cursor="pointer" visible="false">
                        <ui-icon name="file-text" color="brand-accent" size="sm" />
                        <ui-text text="${archivo-nombre}" flex="1" font="metric-sm" color="brand-accent" max-lines="1"></ui-text>
                        <ui-icon name="eye" color="brand-accent" size="sm" />
                    </ui-frame>
                    <ui-text id="recaudo-no-attachment" text="Sin archivo adjunto" flex="1" font="caption" color="text-muted"></ui-text>
                    <ui-frame direction="horizontal" align="center" padding-x="sm" padding-y="xs" gap="2xs" bg="bg-surface" border="hairline" border-color="border-strong" radius="sm" action="onAttachFile" cursor="pointer">
                        <ui-icon name="paperclip" color="brand-primary" size="sm" />
                        <ui-text text="Adjuntar" font="caption" color="brand-primary" font-weight="semibold"></ui-text>
                    </ui-frame>
                </ui-frame>
            </layout>
        </component>

        <component name="tarjeta-plantilla" role="element" design-width="600" design-height="200" description="Tarjeta de plantilla base en catálogo P06 con estado Gratuita o Plan Pro">
            <props>
                <prop name="nombre" type="text" default="Pasaporte" description="Nombre de la plantilla base" />
                <prop name="categoria" type="text" default="Migración y Residencia" description="Categoría de la plantilla" />
                <prop name="resumen" type="text" default="Incluye 3 pasos previos y 5 recaudos sugeridos." description="Resumen de pasos y recaudos" />
                <prop name="bloqueada" type="boolean" default="false" description="Indica si requiere Plan Pro" />
                <prop name="etiqueta-plan" type="text" default="Gratuita" description="Etiqueta de disponibilidad" />
                <prop name="etiqueta-cta" type="text" default="Usar plantilla" description="Texto del botón de acción" />
            </props>
            <events>
                <event name="onSelectTemplate" description="Instanciar plantilla (M05) o abrir Paywall (M06)" />
            </events>
            <states>
                <when prop="bloqueada" is="true">
                <set target="template-card-root" border-color="pro-accent" />
                <set target="template-badge" variante="pro" icono="crown" />
                <set target="template-cta" bg="pro-accent" />
                <set target="template-cta-icon" name="crown" />
                </when>
            </states>
            <layout id="template-card-root" direction="vertical" width="fill" padding="lg" gap="md" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-frame direction="vertical" flex="1" clip="true" gap="2xs">
                        <ui-text text="${nombre}" font="card-title" color="text-primary" max-lines="1"></ui-text>
                        <ui-text text="${categoria}" font="caption" color="text-muted" max-lines="1"></ui-text>
                    </ui-frame>
                    <badge-estado id="template-badge" etiqueta="${etiqueta-plan}" variante="ok" icono="check-circle-2" />
                </ui-frame>
                <ui-text text="${resumen}" font="body" color="text-secondary" multiline="true"></ui-text>
                <ui-frame id="template-cta" direction="horizontal" align="center" justify="center" padding-x="lg" padding-y="sm" gap="xs" bg="brand-primary" radius="sm" action="onSelectTemplate" cursor="pointer">
                    <ui-icon id="template-cta-icon" name="copy-plus" color="text-inverse" size="sm" />
                    <ui-text id="template-cta-label" text="${etiqueta-cta}" font="body" color="text-inverse" font-weight="bold"></ui-text>
                </ui-frame>
            </layout>
        </component>

        <component name="campo-formulario" role="element" design-width="600" design-height="200" description="Campo de entrada o selector con etiqueta, indicador obligatorio y ayuda">
            <props>
                <prop name="etiqueta" type="text" default="Título" description="Etiqueta del campo" />
                <prop name="obligatorio" type="boolean" default="false" description="Indica si es campo obligatorio" />
                <prop name="valor" type="text" default="" description="Valor actual o marcador de posición" />
                <prop name="ayuda" type="text" default="" description="Texto auxiliar o fecha calculada" />
                <prop name="tipo-control" type="enum" default="input" description="Tipo visual del campo" options="input,select,date,textarea" />
                <prop name="estado-campo" type="enum" default="normal" description="Estado del campo" options="normal,focused,error" />
            </props>
            <events>
                <event name="onFieldPress" description="Interacción sobre el campo o selector" />
            </events>
            <states>
                <when prop="obligatorio" is="true">
                <set target="field-req" visible="true" />
                </when>
                <when prop="tipo-control" is="select">
                <set target="field-trailing-icon" name="chevron-down" visible="true" />
                </when>
                <when prop="tipo-control" is="date">
                <set target="field-trailing-icon" name="calendar-clock" visible="true" />
                </when>
                <when prop="tipo-control" is="textarea">
                <set target="field-box" height="textarea-height" align="start" padding-y="md" />
                </when>
                <when prop="estado-campo" is="focused">
                <set target="field-box" border="focus" border-color="brand-primary" />
                </when>
                <when prop="estado-campo" is="error">
                <set target="field-label" color="status-urgent" />
                <set target="field-box" border="focus" border-color="status-urgent" />
                <set target="field-help" color="status-urgent" visible="true" />
                </when>
                <when prop="ayuda" is-not="">
                <set target="field-help" visible="true" />
                </when>
            </states>
            <layout direction="vertical" width="fill" gap="xs">
                <ui-frame direction="horizontal" align="center" gap="2xs">
                    <ui-text id="field-label" text="${etiqueta}" font="caption" color="text-primary" font-weight="semibold"></ui-text>
                    <ui-text id="field-req" text="*" font="caption" color="status-urgent" font-weight="bold" visible="false"></ui-text>
                </ui-frame>
                <ui-frame id="field-box" direction="horizontal" align="center" justify="space-between" width="fill" height="field-height" padding-x="md" gap="sm" bg="bg-surface-elevated" border="strong" border-color="border-strong" radius="sm" action="onFieldPress" cursor="pointer">
                    <ui-text text="${valor}" flex="1" font="body" color="text-primary" max-lines="1"></ui-text>
                    <ui-icon id="field-trailing-icon" name="chevron-down" color="text-secondary" size="md" visible="false" />
                </ui-frame>
                <ui-text id="field-help" text="${ayuda}" font="caption" color="text-secondary" multiline="true" visible="false"></ui-text>
            </layout>
        </component>

        <component name="barra-acciones-pie" role="element" design-width="600" design-height="200" description="Pie de acciones con botón secundario y botón principal">
            <props>
                <prop name="texto-cancelar" type="text" default="Cancelar" description="Etiqueta botón secundario" />
                <prop name="texto-confirmar" type="text" default="Guardar" description="Etiqueta botón principal" />
                <prop name="variante-confirmar" type="enum" default="primary" description="Estilo del botón principal" options="primary,danger,pro" />
            </props>
            <events>
                <event name="onCancel" description="Cancelar o descartar acción" />
                <event name="onConfirm" description="Confirmar o guardar acción" />
            </events>
            <states>
                <when prop="variante-confirmar" is="danger">
                <set target="btn-confirm" bg="status-urgent" />
                </when>
                <when prop="variante-confirmar" is="pro">
                <set target="btn-confirm" bg="pro-accent" />
                </when>
            </states>
            <layout direction="horizontal" align="center" justify="space-between" width="fill" gap="md">
                <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="lg" bg="bg-surface-subtle" border="hairline" border-color="border-subtle" radius="sm" action="onCancel" hover-bg="bg-latent-card" cursor="pointer">
                    <ui-text text="${texto-cancelar}" font="body" color="text-primary" font-weight="semibold"></ui-text>
                </ui-frame>
                <ui-frame id="btn-confirm" direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="lg" bg="brand-primary" radius="sm" action="onConfirm" hover-bg="brand-primary-hover" cursor="pointer">
                    <ui-text text="${texto-confirmar}" font="body" color="text-inverse" font-weight="bold"></ui-text>
                </ui-frame>
            </layout>
        </component>
    </group>

    <group name="Bloques" collapsed="false">
        <component name="lista-tramites-activos" role="block" design-width="600" design-height="200" description="Colección de tarjetas de trámites activos en ventana de acción o en riesgo">
            <props>
                <prop name="titulo-seccion" type="text" default="ACTIVOS" description="Encabezado de sección" />
                <prop name="tramites" type="list" default="[]" description="Lista de trámites activos" />
            </props>
            <events>
                <event name="onSelectTramite" description="Abrir detalle del trámite seleccionado" />
            </events>
            <layout direction="vertical" width="fill" gap="md">
                <ui-text text="${titulo-seccion}" font="badge" color="text-secondary"></ui-text>
                <ui-repeat items="${tramites}" as="item">
                    <tarjeta-tramite action="onSelectTramite" titulo="${item.titulo}" categoria="${item.categoria}" estado-texto="${item.estado}" variante-estado="${item.variante}" detalle-secundario="${item.detalle}" progreso-texto="${item.progreso}" latente="false" />
                </ui-repeat>
            </layout>
        </component>

        <component name="seccion-tramites-latentes" role="block" design-width="600" design-height="200" description="Sección atenuada y colapsable de trámites en espera o latentes">
            <props>
                <prop name="contador" type="text" default="0" description="Cantidad de trámites latentes" />
                <prop name="colapsado" type="boolean" default="false" description="Indica si la lista latente está oculta" />
                <prop name="tramites-latentes" type="list" default="[]" description="Lista de trámites en espera o latentes" />
            </props>
            <events>
                <event name="onToggleLatentes" description="Mostrar u ocultar trámites latentes" />
                <event name="onSelectLatente" description="Abrir detalle de trámite latente" />
            </events>
            <states>
                <when prop="colapsado" is="true">
                <set target="latentes-list-wrap" visible="false" />
                <set target="latentes-toggle-label" text="Mostrar" />
                </when>
            </states>
            <layout direction="vertical" width="fill" padding="md" gap="sm" bg="bg-latent-card" border="hairline" border-color="border-subtle" radius="md">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm" action="onToggleLatentes" cursor="pointer">
                    <ui-frame direction="horizontal" align="center" gap="xs">
                        <ui-icon name="hourglass" color="status-latent" size="sm" />
                        <ui-text text="EN ESPERA / LATENTES (${contador})" font="badge" color="status-latent"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" gap="2xs">
                        <ui-text id="latentes-toggle-label" text="Ocultar" font="caption" color="text-secondary"></ui-text>
                        <ui-icon id="latentes-chevron" name="chevron-down" color="text-secondary" size="sm" />
                    </ui-frame>
                </ui-frame>
                <ui-frame id="latentes-list-wrap" direction="vertical" width="fill" gap="sm">
                    <ui-repeat items="${tramites-latentes}" as="item">
                        <tarjeta-tramite action="onSelectLatente" titulo="${item.titulo}" categoria="${item.categoria}" estado-texto="${item.estado}" variante-estado="latent" detalle-secundario="${item.detalle}" progreso-texto="${item.progreso}" latente="true" />
                    </ui-repeat>
                </ui-frame>
            </layout>
        </component>

        <component name="lista-pasos-previos" role="block" design-width="600" design-height="200" description="Sección y lista ordenada de pasos previos y dependencias del trámite">
            <props>
                <prop name="pasos" type="list" default="[]" description="Lista ordenada de pasos previos" />
            </props>
            <events>
                <event name="onAddStep" description="Abrir modal M03 para agregar paso previo" />
                <event name="onEditStep" description="Abrir modal M03 para editar paso previo" />
                <event name="onOpenStep" description="Abrir pantalla P03 de detalle de paso y recaudos" />
            </events>
            <layout direction="vertical" width="fill" gap="md">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                    <ui-frame direction="horizontal" align="center" gap="xs">
                        <ui-icon name="git-commit-vertical" color="brand-accent" size="md" />
                        <ui-text text="PASOS PREVIOS Y DEPENDENCIAS" font="badge" color="text-secondary"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" padding-x="md" padding-y="xs" gap="2xs" bg="brand-primary" radius="sm" action="onAddStep" cursor="pointer">
                        <ui-icon name="list-plus" color="text-inverse" size="sm" />
                        <ui-text text="Agregar paso previo" font="caption" color="text-inverse" font-weight="bold"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-repeat items="${pasos}" as="item">
                    <item-paso-previo action="onOpenStep" orden="${item.orden}" nombre="${item.nombre}" anticipacion="${item.anticipacion}" fecha-calculada="${item.fecha}" resumen-recaudos="${item.resumen}" />
                </ui-repeat>
            </layout>
        </component>

        <component name="lista-recaudos-paso" role="block" design-width="600" design-height="200" description="Listado de recaudos de un paso previo con formulario rápido para agregar">
            <props>
                <prop name="nuevo-recaudo-texto" type="text" default="" description="Nombre del nuevo recaudo a agregar" />
                <prop name="recaudos" type="list" default="[]" description="Lista de recaudos del paso" />
            </props>
            <events>
                <event name="onAddRecaudo" description="Agregar nuevo recaudo al paso" />
                <event name="onToggleRecaudo" description="Alternar estado Pendiente / Listo" />
                <event name="onAttachRecaudo" description="Abrir selector M04 para adjuntar al recaudo" />
                <event name="onOpenViewer" description="Abrir visor P04 para archivo adjunto" />
            </events>
            <layout direction="vertical" width="fill" gap="md">
                <ui-frame direction="horizontal" align="center" width="fill" gap="sm">
                    <ui-frame direction="horizontal" align="center" height="field-height" flex="1" padding-x="md" bg="bg-surface-elevated" border="strong" border-color="border-strong" radius="sm">
                        <ui-text text="${nuevo-recaudo-texto}" flex="1" font="body" color="text-secondary" max-lines="1"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" justify="center" height="field-height" padding-x="md" gap="2xs" bg="brand-primary" radius="sm" action="onAddRecaudo" cursor="pointer">
                        <ui-icon name="plus" color="text-inverse" size="sm" />
                        <ui-text text="Agregar recaudo" font="caption" color="text-inverse" font-weight="bold"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-text text="RECAUDOS DEL PASO" font="badge" color="text-secondary"></ui-text>
                <ui-repeat items="${recaudos}" as="item">
                    <item-recaudo action="onToggleRecaudo" denominacion="${item.denominacion}" listo="${item.listo}" estado-texto="${item.estado}" archivo-nombre="${item.archivo}" />
                </ui-repeat>
            </layout>
        </component>
    </group>

    <group name="Pantallas" parent="Escenas" collapsed="true">
        <scene name="P01-panel-principal-tramites" target="window" description="Panel Principal de Trámites (CU-01, CU-06, CU-08, CU-09)">
            <props>
                <prop name="titulo-pantalla" type="text" default="Mis Trámites" />
                <prop name="critico-estado" type="text" default="En riesgo" />
                <prop name="critico-variante" type="enum" default="urgent" options="urgent,warning" />
                <prop name="critico-tramite" type="text" default="Renovar Pasaporte" />
                <prop name="critico-paso" type="text" default="Solicitar cita consular" />
                <prop name="critico-cuenta" type="text" default="Vence paso en 4 días" />
                <prop name="critico-limite" type="text" default="Límite final: 15/05/2027" />
                <prop name="tramites-activos" type="list" default="[]" />
                <prop name="latentes-contador" type="text" default="0" />
                <prop name="latentes-colapsado" type="boolean" default="false" />
                <prop name="tramites-latentes" type="list" default="[]" />
            </props>
            <layout direction="vertical" width="fill" height="fill" bg="bg-page">
                <barra-superior-navegacion titulo="${titulo-pantalla}" mostrar-volver="false" icono-accion-primaria="settings" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="lg">
                    <bloque-ruta-critica estado-etiqueta="${critico-estado}" variante-estado="${critico-variante}" tramite-titulo="${critico-tramite}" paso-critico="${critico-paso}" cuenta-paso="${critico-cuenta}" fecha-limite="${critico-limite}" etiqueta-accion="Ver" />
                    <lista-tramites-activos titulo-seccion="ACTIVOS" tramites="${tramites-activos}" />
                    <seccion-tramites-latentes contador="${latentes-contador}" colapsado="${latentes-colapsado}" tramites-latentes="${tramites-latentes}" />
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" padding-x="lg" padding-y="md" gap="md" bg="bg-surface" border-top="border-subtle">
                    <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="lg" gap="xs" bg="bg-surface-subtle" border="hairline" border-color="border-strong" radius="sm" cursor="pointer">
                        <ui-icon name="copy-plus" color="text-primary" size="md" />
                        <ui-text text="Desde plantilla" font="body" color="text-primary" font-weight="semibold"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="lg" gap="xs" bg="brand-primary" radius="sm" action="onNewTramite" hover-bg="brand-primary-hover" cursor="pointer">
                        <ui-icon name="plus" color="text-inverse" size="md" />
                        <ui-text text="Nuevo Trámite" font="body" color="text-inverse" font-weight="bold"></ui-text>
                    </ui-frame>
                </ui-frame>
            </layout>
        </scene>

        <scene name="P02-detalle-tramite" target="window" description="Detalle del Trámite con cuenta regresiva, acceso a taquilla y pasos previos (CU-01, CU-02, CU-04, CU-05, CU-07)">
            <props>
                <prop name="tramite-titulo" type="text" default="Renovar Pasaporte" />
                <prop name="categoria-texto" type="text" default="Migración y Residencia" />
                <prop name="estado-texto" type="text" default="En ventana de acción" />
                <prop name="estado-variante" type="enum" default="warning" options="urgent,warning,ok,latent" />
                <prop name="fecha-limite-resumen" type="text" default="Fecha límite final: 15/05/2027 (Faltan 176 días)" />
                <prop name="notas-generales" type="text" default="Verificar vigencia mínima de 6 meses." />
                <prop name="pasos-previos" type="list" default="[]" />
            </props>
            <states>
                <when prop="notas-generales" is-not="">
                <set target="p02-notas" visible="true" />
                </when>
            </states>
            <layout direction="vertical" width="fill" height="fill" bg="bg-page">
                <barra-superior-navegacion titulo="${tramite-titulo}" mostrar-volver="true" icono-accion-primaria="trash-2" mostrar-accion-secundaria="true" icono-accion-secundaria="pencil" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="lg">
                    <ui-frame direction="vertical" width="fill" padding="lg" gap="md" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-frame direction="horizontal" align="center" wrap="true" gap="sm">
                            <badge-estado etiqueta="${categoria-texto}" variante="accent" icono="file-text" />
                            <badge-estado etiqueta="${estado-texto}" variante="${estado-variante}" icono="calendar-clock" />
                        </ui-frame>
                        <ui-text text="${fecha-limite-resumen}" font="metric-md" color="text-primary" multiline="true"></ui-text>
                        <ui-text id="p02-notas" text="${notas-generales}" font="body" color="text-secondary" multiline="true" visible="false"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" padding="md" gap="sm" bg="brand-accent-soft" border="hairline" border-color="brand-accent" radius="md" cursor="pointer">
                        <ui-frame direction="horizontal" align="center" flex="1" gap="sm">
                            <ui-icon name="briefcase" color="brand-accent" size="lg" />
                            <ui-text text="Vista rápida / Taquilla (Listo para cita)" flex="1" font="body" color="brand-accent" font-weight="bold" multiline="true"></ui-text>
                        </ui-frame>
                        <ui-icon name="arrow-right" color="brand-accent" size="md" />
                    </ui-frame>
                    <lista-pasos-previos pasos="${pasos-previos}" />
                </ui-frame>
            </layout>
        </scene>

        <scene name="P03-detalle-paso-recaudos" target="window" description="Detalle de Paso Previo y Recaudos con estado, adjuntos y visor (CU-04, CU-05)">
            <props>
                <prop name="paso-selector-texto" type="text" default="Paso 1: Reunir recaudos base" />
                <prop name="paso-nombre" type="text" default="Reunir recaudos base" />
                <prop name="paso-meta" type="text" default="Vence: 01/05/2027 (2 sem. antes)" />
                <prop name="avance-texto" type="text" default="Avance: 50% (1/2 listos)" />
                <prop name="nuevo-recaudo" type="text" default="" />
                <prop name="recaudos" type="list" default="[]" />
                <prop name="adjunto-paso-nombre" type="text" default="planilla_solicitud.pdf" />
            </props>
            <states>
                <when prop="adjunto-paso-nombre" is-not="">
                <set target="step-attachment-row" visible="true" />
                </when>
            </states>
            <layout direction="vertical" width="fill" height="fill" bg="bg-page">
                <barra-superior-navegacion titulo="${paso-selector-texto}" mostrar-volver="true" icono-accion-primaria="chevron-down" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="lg">
                    <ui-frame direction="vertical" width="fill" padding="lg" gap="sm" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-text text="${paso-nombre}" font="card-title" color="text-primary" multiline="true"></ui-text>
                        <ui-frame direction="horizontal" align="center" justify="space-between" wrap="true" width="fill" gap="sm">
                            <ui-text text="${paso-meta}" font="metric-sm" color="text-secondary"></ui-text>
                            <ui-text text="${avance-texto}" font="metric-sm" color="brand-primary"></ui-text>
                        </ui-frame>
                    </ui-frame>
                    <lista-recaudos-paso nuevo-recaudo-texto="${nuevo-recaudo}" recaudos="${recaudos}" />
                    <ui-frame direction="vertical" width="fill" padding="md" gap="sm" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                            <ui-text text="ADJUNTOS DEL PASO" font="badge" color="text-secondary"></ui-text>
                            <ui-frame direction="horizontal" align="center" padding-x="sm" padding-y="xs" gap="2xs" bg="bg-surface-subtle" border="hairline" border-color="border-strong" radius="sm" cursor="pointer">
                                <ui-icon name="paperclip" color="brand-primary" size="sm" />
                                <ui-text text="Adjuntar al paso" font="caption" color="brand-primary" font-weight="semibold"></ui-text>
                            </ui-frame>
                        </ui-frame>
                        <ui-frame id="step-attachment-row" direction="horizontal" align="center" justify="space-between" width="fill" padding="sm" bg="bg-surface-subtle" radius="sm" cursor="pointer" visible="false">
                            <ui-frame direction="horizontal" align="center" flex="1" gap="xs">
                                <ui-icon name="file-text" color="brand-accent" size="sm" />
                                <ui-text text="${adjunto-paso-nombre}" flex="1" font="metric-sm" color="brand-accent" max-lines="1"></ui-text>
                            </ui-frame>
                            <ui-frame direction="horizontal" align="center" gap="2xs">
                                <ui-text text="Ver" font="caption" color="brand-accent" font-weight="bold"></ui-text>
                                <ui-icon name="eye" color="brand-accent" size="sm" />
                            </ui-frame>
                        </ui-frame>
                    </ui-frame>
                </ui-frame>
            </layout>
        </scene>

        <scene name="P04-visor-integrado-documentos" target="window" description="Visor Integrado de Documentos cifrados locales con soporte offline (CU-05, CU-07)">
            <props>
                <prop name="archivo-nombre" type="text" default="cedula_frente.jpg" />
                <prop name="contexto-recaudo" type="text" default="Copia de cédula de identidad" />
                <prop name="estado-offline" type="text" default="Offline OK" />
                <prop name="pagina-texto" type="text" default="Página 1 / 1" />
                <prop name="zoom-texto" type="text" default="100%" />
            </props>
            <layout direction="vertical" width="fill" height="fill" bg="bg-page">
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" height="topbar-height" padding-x="lg" gap="sm" bg="bg-surface" border-bottom="border-subtle">
                    <ui-frame direction="horizontal" align="center" flex="1" clip="true" gap="sm">
                        <ui-frame direction="horizontal" align="center" justify="center" padding="xs" radius="sm" hover-bg="bg-surface-subtle" cursor="pointer">
                            <ui-icon name="x" color="text-primary" size="md" />
                        </ui-frame>
                        <ui-frame direction="vertical" flex="1" clip="true" gap="2xs">
                            <ui-text text="${archivo-nombre}" font="metric-sm" color="text-primary" max-lines="1"></ui-text>
                            <ui-text text="${contexto-recaudo}" font="caption" color="text-muted" max-lines="1"></ui-text>
                        </ui-frame>
                    </ui-frame>
                    <badge-estado etiqueta="${estado-offline}" variante="ok" icono="wifi-off" />
                </ui-frame>
                <ui-frame direction="vertical" align="center" justify="center" width="fill" flex="1" scroll="both" padding="lg" gap="md" bg="bg-surface-subtle">
                    <ui-frame direction="vertical" align="center" justify="center" width="fill" height="viewer-min-height" padding="xl" gap="sm" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-icon name="shield-check" color="status-ok" size="lg" />
                        <ui-text text="${archivo-nombre}" font="card-title" color="text-primary"></ui-text>
                        <ui-text text="Documento resguardado localmente en el dispositivo" font="caption" color="text-secondary"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" padding-x="lg" padding-y="md" gap="sm" bg="bg-surface" border-top="border-subtle">
                    <ui-frame direction="horizontal" align="center" gap="xs">
                        <ui-frame direction="horizontal" align="center" justify="center" padding="xs" bg="bg-surface-subtle" border="hairline" border-color="border-strong" radius="sm" cursor="pointer">
                            <ui-icon name="zoom-out" color="text-primary" size="md" />
                        </ui-frame>
                        <ui-text text="${zoom-texto}" font="metric-sm" color="text-primary"></ui-text>
                        <ui-frame direction="horizontal" align="center" justify="center" padding="xs" bg="bg-surface-subtle" border="hairline" border-color="border-strong" radius="sm" cursor="pointer">
                            <ui-icon name="zoom-in" color="text-primary" size="md" />
                        </ui-frame>
                    </ui-frame>
                    <ui-text text="${pagina-texto}" font="metric-sm" color="text-secondary"></ui-text>
                    <ui-frame direction="horizontal" align="center" justify="center" padding-x="sm" padding-y="xs" bg="bg-surface-subtle" border="hairline" border-color="border-subtle" radius="sm" cursor="pointer">
                        <ui-text text="Ajustar ancho" font="caption" color="text-primary" font-weight="semibold"></ui-text>
                    </ui-frame>
                </ui-frame>
            </layout>
        </scene>

        <scene name="P05-vista-rapida-taquilla" target="window" description="Vista Rápida de Taquilla offline con recaudos consolidados y accesos directos a archivos (CU-07)">
            <props>
                <prop name="tramite-titulo" type="text" default="Renovar Pasaporte" />
                <prop name="estado-offline" type="text" default="Offline Listo" />
                <prop name="recaudos-consolidados" type="list" default="[]" />
            </props>
            <layout direction="vertical" width="fill" height="fill" bg="bg-page">
                <barra-superior-navegacion titulo="Vista Rápida / Taquilla" mostrar-volver="true" icono-accion-primaria="shield-check" badge-texto="${estado-offline}" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="lg">
                    <ui-frame direction="vertical" width="fill" padding="md" gap="2xs" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-text text="TRÁMITE ACTIVO" font="badge" color="text-muted"></ui-text>
                        <ui-text text="${tramite-titulo}" font="card-title" color="text-primary" multiline="true"></ui-text>
                    </ui-frame>
                    <ui-text text="RECAUDOS CONSOLIDADOS" font="badge" color="text-secondary"></ui-text>
                    <ui-repeat items="${recaudos-consolidados}" as="item">
                        <item-recaudo denominacion="${item.denominacion}" listo="${item.listo}" estado-texto="${item.estado}" archivo-nombre="${item.archivo}" />
                    </ui-repeat>
                </ui-frame>
                <ui-frame direction="horizontal" align="center" justify="center" width="fill" padding-x="lg" padding-y="md" bg="bg-surface" border-top="border-subtle">
                    <ui-frame direction="horizontal" align="center" justify="center" width="fill" height="field-height" padding-x="lg" bg="bg-surface-subtle" border="hairline" border-color="border-strong" radius="sm" cursor="pointer">
                        <ui-text text="Salir de Vista Rápida" font="body" color="text-primary" font-weight="semibold"></ui-text>
                    </ui-frame>
                </ui-frame>
            </layout>
        </scene>

        <scene name="P06-catalogo-plantillas-base" target="window" description="Catálogo de plantillas base gratuitas y Plan Pro (CU-08)">
            <props>
                <prop name="introduccion-texto" type="text" default="Elige una plantilla para calcular pasos y recaudos hacia atrás a partir de tu fecha límite objetivo." />
                <prop name="plantillas" type="list" default="[]" />
            </props>
            <layout direction="vertical" width="fill" height="fill" bg="bg-page">
                <barra-superior-navegacion titulo="Plantillas Base" mostrar-volver="true" icono-accion-primaria="crown" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="lg">
                    <ui-frame direction="vertical" width="fill" padding="md" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-text text="${introduccion-texto}" font="body" color="text-secondary" multiline="true"></ui-text>
                    </ui-frame>
                    <ui-repeat items="${plantillas}" as="item">
                        <tarjeta-plantilla nombre="${item.nombre}" categoria="${item.categoria}" resumen="${item.resumen}" bloqueada="${item.bloqueada}" etiqueta-plan="${item.plan}" etiqueta-cta="${item.cta}" />
                    </ui-repeat>
                </ui-frame>
            </layout>
        </scene>

        <scene name="P07-configuracion-respaldo-datos" target="window" description="Configuración de plan, restauración de compras y respaldo de datos cifrados (CU-09, CU-12)">
            <props>
                <prop name="plan-estado" type="text" default="Plan Gratuito (Freemium)" />
                <prop name="es-pro" type="boolean" default="false" />
                <prop name="alcance-respaldo" type="text" default="Todos los trámites" />
                <prop name="estado-operacion" type="text" default="" />
                <prop name="nota-cifrado" type="text" default="Los documentos adjuntos se resguardan cifrados en el dispositivo y se incluyen en el paquete de exportación." />
            </props>
            <states>
                <when prop="es-pro" is="true">
                <set target="p07-plan-badge" variante="pro" icono="crown" />
                </when>
                <when prop="estado-operacion" is-not="">
                <set target="p07-feedback" visible="true" />
                </when>
            </states>
            <layout direction="vertical" width="fill" height="fill" bg="bg-page">
                <barra-superior-navegacion titulo="Configuración y Respaldo" mostrar-volver="true" icono-accion-primaria="shield-check" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="lg">
                    <ui-frame direction="vertical" width="fill" padding="lg" gap="md" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                            <ui-text text="PLAN ACTUAL" font="badge" color="text-secondary"></ui-text>
                            <badge-estado id="p07-plan-badge" etiqueta="${plan-estado}" variante="latent" icono="crown" />
                        </ui-frame>
                        <ui-frame direction="horizontal" align="center" justify="center" height="field-height" padding-x="lg" gap="xs" bg="pro-accent" radius="sm" cursor="pointer">
                            <ui-icon name="crown" color="text-inverse" size="sm" />
                            <ui-text text="Adquirir o gestionar Plan Pro" font="body" color="text-inverse" font-weight="bold"></ui-text>
                        </ui-frame>
                        <ui-frame direction="horizontal" align="center" justify="center" height="field-height" padding-x="lg" gap="xs" bg="bg-surface-subtle" border="hairline" border-color="border-strong" radius="sm" cursor="pointer">
                            <ui-icon name="rotate-ccw" color="text-primary" size="sm" />
                            <ui-text text="Restaurar compras" font="body" color="text-primary" font-weight="semibold"></ui-text>
                        </ui-frame>
                    </ui-frame>
                    <ui-frame direction="vertical" width="fill" padding="lg" gap="md" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-text text="RESPALDO DE DATOS" font="badge" color="text-secondary"></ui-text>
                        <campo-formulario etiqueta="Alcance de exportación" valor="${alcance-respaldo}" tipo-control="select" />
                        <ui-frame direction="horizontal" align="center" justify="center" height="field-height" padding-x="lg" gap="xs" bg="brand-primary" radius="sm" hover-bg="brand-primary-hover" cursor="pointer">
                            <ui-icon name="download" color="text-inverse" size="sm" />
                            <ui-text text="Exportar respaldo" font="body" color="text-inverse" font-weight="bold"></ui-text>
                        </ui-frame>
                        <ui-frame direction="horizontal" align="start" padding="sm" gap="xs" bg="bg-surface-subtle" radius="sm">
                            <ui-icon name="shield-check" color="status-ok" size="sm" />
                            <ui-text text="${nota-cifrado}" flex="1" font="caption" color="text-secondary" multiline="true"></ui-text>
                        </ui-frame>
                    </ui-frame>
                    <ui-frame id="p07-feedback" direction="horizontal" align="center" padding="md" gap="xs" bg="brand-primary-soft" radius="md" visible="false">
                        <ui-icon name="check-circle-2" color="brand-primary" size="sm" />
                        <ui-text text="${estado-operacion}" flex="1" font="caption" color="brand-primary" font-weight="semibold" multiline="true"></ui-text>
                    </ui-frame>
                </ui-frame>
            </layout>
        </scene>
    </group>

    <group name="Modales" parent="Escenas" collapsed="false">
        <scene name="M01-formulario-tramite" target="window" description="Modal / Bottom Sheet para crear o editar un trámite (CU-01)">
            <props>
                <prop name="titulo-modal" type="text" default="Nuevo Trámite" />
                <prop name="titulo-valor" type="text" default="" />
                <prop name="categoria-valor" type="text" default="Seleccionar categoría" />
                <prop name="fecha-limite-valor" type="text" default="DD/MM/AAAA" />
                <prop name="notas-valor" type="text" default="" />
            </props>
            <layout direction="vertical" width="fill" height="fill" bg="bg-surface-elevated">
                <encabezado-modal titulo="${titulo-modal}" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="md">
                    <campo-formulario etiqueta="Título" obligatorio="true" valor="${titulo-valor}" tipo-control="input" />
                    <campo-formulario etiqueta="Categoría" valor="${categoria-valor}" tipo-control="select" />
                    <campo-formulario etiqueta="Fecha límite final" obligatorio="true" valor="${fecha-limite-valor}" tipo-control="date" />
                    <campo-formulario etiqueta="Notas generales" valor="${notas-valor}" tipo-control="textarea" />
                </ui-frame>
                <ui-frame direction="vertical" width="fill" padding="lg" bg="bg-surface" border-top="border-subtle">
                    <barra-acciones-pie texto-cancelar="Cancelar" texto-confirmar="Guardar" variante-confirmar="primary" />
                </ui-frame>
            </layout>
        </scene>

        <scene name="M02-confirmacion-eliminacion-tramite" target="window" description="Diálogo de confirmación antes de eliminar permanentemente un trámite (CU-01)">
            <props>
                <prop name="tramite-nombre" type="text" default="Renovar Pasaporte" />
                <prop name="mensaje-advertencia" type="text" default="¿Deseas eliminar este trámite? Se borrarán sus pasos previos, recaudos, archivos adjuntos locales y alertas asociadas." />
            </props>
            <layout direction="vertical" align="center" justify="center" width="fill" height="fill" padding="xl" bg="bg-page">
                <ui-frame direction="vertical" width="fill" padding="xl" gap="lg" bg="bg-surface-elevated" border="strong" border-color="status-urgent" radius="lg">
                    <ui-frame direction="horizontal" align="center" gap="sm">
                        <ui-icon name="trash-2" color="status-urgent" size="lg" />
                        <ui-text text="Eliminar trámite" flex="1" font="modal-title" color="text-primary"></ui-text>
                    </ui-frame>
                    <ui-text text="${tramite-nombre}" font="card-title" color="status-urgent" multiline="true"></ui-text>
                    <ui-text text="${mensaje-advertencia}" font="body" color="text-secondary" multiline="true"></ui-text>
                    <barra-acciones-pie texto-cancelar="Cancelar" texto-confirmar="Eliminar" variante-confirmar="danger" />
                </ui-frame>
            </layout>
        </scene>

        <scene name="M03-configuracion-paso-previo" target="window" description="Modal / Bottom Sheet para crear, editar o reordenar un paso previo (CU-02)">
            <props>
                <prop name="titulo-modal" type="text" default="Agregar paso previo" />
                <prop name="nombre-paso" type="text" default="" />
                <prop name="orden-texto" type="text" default="Posición 1 de 2" />
                <prop name="cantidad-anticipacion" type="text" default="2" />
                <prop name="unidad-anticipacion" type="text" default="Semanas" />
                <prop name="fecha-calculada" type="text" default="Fecha estimada calculada: 01/05/2027" />
            </props>
            <layout direction="vertical" width="fill" height="fill" bg="bg-surface-elevated">
                <encabezado-modal titulo="${titulo-modal}" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="md">
                    <campo-formulario etiqueta="Nombre del paso" obligatorio="true" valor="${nombre-paso}" tipo-control="input" />
                    <ui-frame direction="vertical" width="fill" gap="xs">
                        <ui-text text="Orden en la secuencia" font="caption" color="text-primary" font-weight="semibold"></ui-text>
                        <ui-frame direction="horizontal" align="center" width="fill" gap="sm">
                            <ui-frame direction="horizontal" align="center" justify="space-between" height="field-height" flex="1" padding-x="md" bg="bg-surface" border="strong" border-color="border-strong" radius="sm">
                                <ui-text text="${orden-texto}" flex="1" font="metric-sm" color="text-primary" max-lines="1"></ui-text>
                                <ui-icon name="chevron-down" color="text-secondary" size="md" />
                            </ui-frame>
                            <ui-frame direction="horizontal" align="center" justify="center" height="field-height" padding-x="md" gap="2xs" bg="bg-surface-subtle" border="hairline" border-color="border-strong" radius="sm" cursor="pointer">
                                <ui-icon name="arrow-up-down" color="text-primary" size="sm" />
                                <ui-text text="Reordenar" font="caption" color="text-primary" font-weight="semibold"></ui-text>
                            </ui-frame>
                        </ui-frame>
                    </ui-frame>
                    <ui-frame direction="vertical" width="fill" gap="xs">
                        <ui-text text="Anticipación requerida" font="caption" color="text-primary" font-weight="semibold"></ui-text>
                        <ui-frame direction="horizontal" align="center" width="fill" gap="sm">
                            <ui-frame direction="horizontal" align="center" justify="center" height="field-height" padding-x="lg" bg="bg-surface" border="strong" border-color="border-strong" radius="sm">
                                <ui-text text="${cantidad-anticipacion}" font="hero-num" color="text-primary"></ui-text>
                            </ui-frame>
                            <ui-frame direction="horizontal" align="center" justify="space-between" height="field-height" flex="1" padding-x="md" bg="bg-surface" border="strong" border-color="border-strong" radius="sm">
                                <ui-text text="${unidad-anticipacion}" flex="1" font="body" color="text-primary"></ui-text>
                                <ui-icon name="chevron-down" color="text-secondary" size="md" />
                            </ui-frame>
                        </ui-frame>
                        <ui-text text="${fecha-calculada}" font="metric-sm" color="brand-accent" multiline="true"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="vertical" width="fill" padding="lg" bg="bg-surface" border-top="border-subtle">
                    <barra-acciones-pie texto-cancelar="Cancelar" texto-confirmar="Guardar" variante-confirmar="primary" />
                </ui-frame>
            </layout>
        </scene>

        <scene name="M04-selector-origen-archivo" target="window" description="Modal / Bottom Sheet para elegir cámara o archivos/galería al adjuntar documento (CU-05)">
            <props>
                <prop name="destino-nombre" type="text" default="Comprobante de pago de arancel" />
            </props>
            <layout direction="vertical" width="fill" height="fill" bg="bg-surface-elevated">
                <encabezado-modal titulo="Adjuntar archivo" subtitulo="Destino: ${destino-nombre}" />
                <ui-frame direction="vertical" width="fill" flex="1" padding="lg" gap="md">
                    <ui-frame direction="horizontal" align="center" width="fill" padding="lg" gap="md" bg="bg-surface" border="strong" border-color="border-strong" radius="md" hover-bg="bg-surface-subtle" cursor="pointer">
                        <ui-icon name="camera" color="brand-primary" size="lg" />
                        <ui-frame direction="vertical" flex="1" gap="2xs">
                            <ui-text text="Cámara" font="card-title" color="text-primary"></ui-text>
                            <ui-text text="Capturar fotografía del documento o comprobante" font="caption" color="text-secondary" multiline="true"></ui-text>
                        </ui-frame>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" width="fill" padding="lg" gap="md" bg="bg-surface" border="strong" border-color="border-strong" radius="md" hover-bg="bg-surface-subtle" cursor="pointer">
                        <ui-icon name="file-text" color="brand-accent" size="lg" />
                        <ui-frame direction="vertical" flex="1" gap="2xs">
                            <ui-text text="Archivos / Galería" font="card-title" color="text-primary"></ui-text>
                            <ui-text text="Seleccionar imagen o PDF desde el dispositivo" font="caption" color="text-secondary" multiline="true"></ui-text>
                        </ui-frame>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="vertical" width="fill" padding="lg" bg="bg-surface" border-top="border-subtle">
                    <ui-frame direction="horizontal" align="center" justify="center" width="fill" height="field-height" padding-x="lg" bg="bg-surface-subtle" border="hairline" border-color="border-subtle" radius="sm" cursor="pointer">
                        <ui-text text="Cancelar" font="body" color="text-primary" font-weight="semibold"></ui-text>
                    </ui-frame>
                </ui-frame>
            </layout>
        </scene>

        <scene name="M05-instanciar-tramite-plantilla" target="window" description="Modal / Bottom Sheet para ingresar fecha límite objetivo e instanciar trámite desde plantilla (CU-08)">
            <props>
                <prop name="plantilla-nombre" type="text" default="Pasaporte" />
                <prop name="resumen-estructura" type="text" default="Se generarán 3 pasos previos y 5 recaudos sugeridos con fechas calculadas en cuenta regresiva." />
                <prop name="fecha-objetivo" type="text" default="DD/MM/AAAA" />
            </props>
            <layout direction="vertical" width="fill" height="fill" bg="bg-surface-elevated">
                <encabezado-modal titulo="Crear desde plantilla" subtitulo="Plantilla: ${plantilla-nombre}" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="lg">
                    <ui-frame direction="vertical" width="fill" padding="md" gap="xs" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-text text="ESTRUCTURA A GENERAR" font="badge" color="brand-accent"></ui-text>
                        <ui-text text="${resumen-estructura}" font="body" color="text-secondary" multiline="true"></ui-text>
                    </ui-frame>
                    <campo-formulario etiqueta="Fecha límite objetivo" obligatorio="true" valor="${fecha-objetivo}" tipo-control="date" />
                </ui-frame>
                <ui-frame direction="vertical" width="fill" padding="lg" bg="bg-surface" border-top="border-subtle">
                    <barra-acciones-pie texto-cancelar="Cancelar" texto-confirmar="Crear trámite" variante-confirmar="primary" />
                </ui-frame>
            </layout>
        </scene>

        <scene name="M06-paywall-contextual-personal-pro" target="window" description="Modal / Bottom Sheet de paywall contextual para Personal Pro (CU-01, CU-05, CU-08, CU-09, CU-12)">
            <props>
                <prop name="motivo-titulo" type="text" default="Desbloquea Personal Pro" />
                <prop name="motivo-subtitulo" type="text" default="Amplía tus límites, accede a todas las plantillas base y exporta respaldos cifrados completos." />
                <prop name="modalidad-seleccionada" type="enum" default="lifetime" options="lifetime,annual" />
                <prop name="precio-lifetime" type="text" default="$29.00" />
                <prop name="precio-anual" type="text" default="$12.00/a" />
            </props>
            <states>
                <when prop="modalidad-seleccionada" is="annual">
                <set target="plan-lifetime-card" bg="bg-surface" border="hairline" border-color="border-strong" />
                <set target="plan-annual-card" bg="pro-accent-bg" border="focus" border-color="pro-accent" />
                </when>
            </states>
            <layout direction="vertical" width="fill" height="fill" bg="bg-surface-elevated">
                <encabezado-modal titulo="${motivo-titulo}" subtitulo="${motivo-subtitulo}" />
                <ui-frame direction="vertical" width="fill" flex="1" scroll="vertical" padding="lg" gap="md">
                    <ui-frame direction="vertical" width="fill" padding="md" gap="sm" bg="bg-surface" border="hairline" border-color="border-subtle" radius="md">
                        <ui-frame direction="horizontal" align="center" gap="sm">
                            <ui-icon name="check-circle-2" color="status-ok" size="sm" />
                            <ui-text text="Trámites y adjuntos cifrados ampliados" flex="1" font="body" color="text-primary" multiline="true"></ui-text>
                        </ui-frame>
                        <ui-frame direction="horizontal" align="center" gap="sm">
                            <ui-icon name="check-circle-2" color="status-ok" size="sm" />
                            <ui-text text="Acceso completo a todas las plantillas base" flex="1" font="body" color="text-primary" multiline="true"></ui-text>
                        </ui-frame>
                        <ui-frame direction="horizontal" align="center" gap="sm">
                            <ui-icon name="check-circle-2" color="status-ok" size="sm" />
                            <ui-text text="Exportación de respaldo de datos y adjuntos" flex="1" font="body" color="text-primary" multiline="true"></ui-text>
                        </ui-frame>
                    </ui-frame>
                    <ui-text text="MODALIDAD DE PLAN" font="badge" color="text-secondary"></ui-text>
                    <ui-frame id="plan-lifetime-card" direction="horizontal" align="center" justify="space-between" width="fill" padding="md" bg="pro-accent-bg" border="focus" border-color="pro-accent" radius="md" cursor="pointer">
                        <ui-frame direction="vertical" flex="1" gap="2xs">
                            <ui-text text="Pago único Lifetime" font="card-title" color="text-primary"></ui-text>
                            <ui-text text="Sin suscripciones recurrentes" font="caption" color="text-secondary"></ui-text>
                        </ui-frame>
                        <ui-text text="${precio-lifetime}" font="metric-md" color="pro-accent"></ui-text>
                    </ui-frame>
                    <ui-frame id="plan-annual-card" direction="horizontal" align="center" justify="space-between" width="fill" padding="md" bg="bg-surface" border="hairline" border-color="border-strong" radius="md" cursor="pointer">
                        <ui-frame direction="vertical" flex="1" gap="2xs">
                            <ui-text text="Suscripción anual" font="card-title" color="text-primary"></ui-text>
                            <ui-text text="Renovación anual flexible" font="caption" color="text-secondary"></ui-text>
                        </ui-frame>
                        <ui-text text="${precio-anual}" font="metric-md" color="text-primary"></ui-text>
                    </ui-frame>
                </ui-frame>
                <ui-frame direction="vertical" width="fill" padding="lg" gap="sm" bg="bg-surface" border-top="border-subtle">
                    <ui-frame direction="horizontal" align="center" justify="center" width="fill" height="field-height" padding-x="lg" gap="xs" bg="pro-accent" radius="sm" cursor="pointer">
                        <ui-icon name="crown" color="text-inverse" size="sm" />
                        <ui-text text="Continuar / Comprar" font="body" color="text-inverse" font-weight="bold"></ui-text>
                    </ui-frame>
                    <ui-frame direction="horizontal" align="center" justify="space-between" width="fill" gap="sm">
                        <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="md" gap="2xs" bg="bg-surface-subtle" border="hairline" border-color="border-strong" radius="sm" cursor="pointer">
                            <ui-icon name="rotate-ccw" color="text-primary" size="sm" />
                            <ui-text text="Restaurar compras" font="caption" color="text-primary" font-weight="semibold"></ui-text>
                        </ui-frame>
                        <ui-frame direction="horizontal" align="center" justify="center" height="field-height" flex="1" padding-x="md" bg="bg-surface-subtle" border="hairline" border-color="border-subtle" radius="sm" cursor="pointer">
                            <ui-text text="Ahora no / Cerrar" font="caption" color="text-secondary" font-weight="semibold"></ui-text>
                        </ui-frame>
                    </ui-frame>
                </ui-frame>
            </layout>
        </scene>
    </group>

    <journeys>
        <journey name="journey-cu01-crear-consultar-editar-mobile-portrait" title="CU-01 (Happy Path): Crear, Consultar y Editar Trámite" initial-preview="p-panel-inicial" width="393" height="852" description="Flujo principal completo de creación de un trámite nuevo desde P01 mediante M01, inspección en P02, edición de fecha límite/notas y retorno actualizado al panel.">
            <preview id="p-panel-inicial" label="1. Panel Principal (Inicial)" scene="P01-panel-principal-tramites" x="5" y="143" breakpoint="mobile" orientation="portrait">
                <prop name="titulo-pantalla" value="Mis Trámites" />
                <prop name="critico-estado" value="En riesgo" />
                <prop name="critico-variante" value="urgent" />
                <prop name="critico-tramite" value="Renovar Pasaporte" />
                <prop name="critico-paso" value="Solicitar cita consular" />
                <prop name="critico-cuenta" value="Vence paso en 4 días" />
                <prop name="critico-limite" value="Límite final: 15/05/2027" />
                <prop name="tramites-activos" value="${mocks.cu01_happy_activos_inicial}" />
                <prop name="latentes-contador" value="1" />
                <prop name="latentes-colapsado" value="false" />
                <prop name="tramites-latentes" value="${mocks.cu01_happy_latentes}" />
            </preview>
            <preview id="p-modal-nuevo" label="2. Nuevo Trámite (M01)" scene="M01-formulario-tramite" role="overlay" overlay="bottom-sheet" x="540" y="141" breakpoint="mobile" orientation="portrait">
                <prop name="titulo-modal" value="Nuevo Trámite" />
                <prop name="titulo-valor" value="Apostilla Título Universitario" />
                <prop name="categoria-valor" value="Educación y Legalizaciones" />
                <prop name="fecha-limite-valor" value="17/03/2027" />
                <prop name="notas-valor" value="Llevar fondo negro autenticado y timbre fiscal." />
            </preview>
            <preview id="p-panel-creado" label="3. Panel con Trámite Creado" scene="P01-panel-principal-tramites" x="1030" y="67" breakpoint="mobile" orientation="portrait">
                <prop name="titulo-pantalla" value="Mis Trámites" />
                <prop name="critico-estado" value="En riesgo" />
                <prop name="critico-variante" value="urgent" />
                <prop name="critico-tramite" value="Renovar Pasaporte" />
                <prop name="critico-paso" value="Solicitar cita consular" />
                <prop name="critico-cuenta" value="Vence paso en 4 días" />
                <prop name="critico-limite" value="Límite final: 15/05/2027" />
                <prop name="tramites-activos" value="${mocks.cu01_happy_activos_creado}" />
                <prop name="latentes-contador" value="1" />
                <prop name="latentes-colapsado" value="false" />
                <prop name="tramites-latentes" value="${mocks.cu01_happy_latentes}" />
            </preview>
            <preview id="p-detalle-tramite" label="4. Detalle del Trámite (P02)" scene="P02-detalle-tramite" x="1492" y="141" breakpoint="mobile" orientation="portrait">
                <prop name="tramite-titulo" value="Apostilla Título Universitario" />
                <prop name="categoria-texto" value="Educación y Legalizaciones" />
                <prop name="estado-texto" value="En ventana de acción" />
                <prop name="estado-variante" value="warning" />
                <prop name="fecha-limite-resumen" value="Fecha límite final: 17/03/2027 (Faltan 116 días)" />
                <prop name="notas-generales" value="Llevar fondo negro autenticado y timbre fiscal." />
                <prop name="pasos-previos" value="${mocks.cu01_happy_pasos_nuevo}" />
            </preview>
            <preview id="p-modal-editar" label="5. Editar Trámite (M01)" scene="M01-formulario-tramite" role="overlay" overlay="bottom-sheet" x="1980" y="64" breakpoint="mobile" orientation="portrait">
                <prop name="titulo-modal" value="Editar Trámite" />
                <prop name="titulo-valor" value="Apostilla Título Universitario" />
                <prop name="categoria-valor" value="Educación y Legalizaciones" />
                <prop name="fecha-limite-valor" value="30/03/2027" />
                <prop name="notas-valor" value="Llevar fondo negro autenticado, timbre fiscal y copia de cédula." />
            </preview>
            <preview id="p-detalle-editado" label="6. Detalle Actualizado (P02)" scene="P02-detalle-tramite" x="1489" y="801" breakpoint="mobile" orientation="portrait">
                <prop name="tramite-titulo" value="Apostilla Título Universitario" />
                <prop name="categoria-texto" value="Educación y Legalizaciones" />
                <prop name="estado-texto" value="En ventana de acción" />
                <prop name="estado-variante" value="warning" />
                <prop name="fecha-limite-resumen" value="Fecha límite final: 30/03/2027 (Faltan 129 días)" />
                <prop name="notas-generales" value="Llevar fondo negro autenticado, timbre fiscal y copia de cédula." />
                <prop name="pasos-previos" value="${mocks.cu01_happy_pasos_nuevo}" />
            </preview>
            <segue from="p-panel-inicial" on="onNewTramite" to="p-modal-nuevo" />
            <segue from="p-modal-nuevo" on="onClose" action="dismiss" />
            <segue from="p-modal-nuevo" on="onCancel" action="dismiss" />
            <segue from="p-modal-nuevo" on="onConfirm" to="p-panel-creado" toast="Trámite creado y cuenta regresiva calculada" />
            <segue from="p-panel-creado" on="onSelectTramite" to="p-detalle-tramite" />
            <segue from="p-detalle-tramite" on="onBack" to="p-panel-creado" />
            <segue from="p-detalle-tramite" on="onSecondaryAction" to="p-modal-editar" />
            <segue from="p-modal-editar" on="onClose" action="dismiss" />
            <segue from="p-modal-editar" on="onCancel" action="dismiss" />
            <segue from="p-modal-editar" on="onConfirm" to="p-detalle-editado" toast="Cambios guardados y fechas recalculadas" />
            <segue from="p-detalle-editado" on="onBack" to="p-panel-creado" />
        </journey>
    </journeys>
</soda>
