        <color name="bg-surface" light="#FFFFFF" dark="#111827" category="Superficies" />
        <color name="bg-surface-elevated" light="#FFFFFF" dark="#1E293B" category="Superficies" />
        <color name="bg-surface-subtle" light="#F1F5F9" dark="#172033" category="Superficies" />
        <color name="bg-latent-card" light="#F8FAFC" dark="#0F172A" category="Superficies" />
        <color name="border-subtle" light="#CBD5E1" dark="#283548" category="Bordes" />
        <color name="border-strong" light="#64748B" dark="#475569" category="Bordes" />
        <color name="text-primary" light="#0F172A" dark="#F8FAFC" category="Textos" />
        <color name="text-secondary" light="#334155" dark="#CBD5E1" category="Textos" />
        <color name="text-muted" light="#475569" dark="#94A3B8" category="Textos" />
        <color name="text-inverse" light="#FFFFFF" dark="#0B1120" category="Textos" />
        <color name="text-error" light="#B91C1C" dark="#FCA5A5" category="Textos" />
        <font-family name="font-sans" value="'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
        <font-family name="font-brand" value="'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif" />
        <font-family name="font-mono" value="'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" />
        <font-size name="hero" value="34px" />
        <font-size name="xl" value="21px" />
        <font-size name="md" value="16px" />
        <font-size name="base" value="14px" />
        <font-size name="num-md" value="15px" />
        <font-size name="num-sm" value="13px" />
        <font-size name="sm" value="12px" />
        <font-size name="xs" value="11px" />
        <font-weight name="regular" value="400" />
        <font-weight name="medium" value="500" />
        <font-weight name="semibold" value="600" />
        <font-weight name="bold" value="700" />
        <font-weight name="extrabold" value="800" />
        <font name="display-hero" font-size="hero" font-family="font-mono" font-weight="extrabold" />
        <font name="screen-title" font-size="xl" font-family="font-brand" font-weight="bold" />
        <font name="modal-title" font-size="lg" font-family="font-sans" font-weight="bold" />
        <font name="card-title" font-size="md" font-family="font-sans" font-weight="semibold" />
