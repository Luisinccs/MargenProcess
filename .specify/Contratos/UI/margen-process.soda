        <color name="brand-primary-hover" light="#115E59" dark="#14B8A6" />
        <color name="brand-primary-soft" light="#CCFBF1" dark="#132A2E" />
        <color name="brand-accent" light="#1D4ED8" dark="#60A5FA" />
        <color name="brand-accent-soft" light="#DBEAFE" dark="#172542" />
        <color name="status-urgent" light="#B91C1C" dark="#FCA5A5" category="Estados" />
        <color name="status-urgent-bg" light="#FEE2E2" dark="#2E171E" category="Estados" />
        <color name="status-warning" light="#B45309" dark="#FCD34D" category="Estados" />
        <color name="status-warning-bg" light="#FEF3C7" dark="#2E2311" category="Estados" />
