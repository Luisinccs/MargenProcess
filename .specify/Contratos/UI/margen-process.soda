        <color name="status-latent" light="#475569" dark="#94A3B8" category="Estados" />
        <color name="status-latent-bg" light="#E2E8F0" dark="#1C2536" category="Estados" />
        <color name="pro-accent" light="#6D28D9" dark="#C4B5FD" />
        <color name="pro-accent-bg" light="#EDE9FE" dark="#241A3B" />
