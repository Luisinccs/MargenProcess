    <icon-defs>
        <icon name="plus" viewBox="0 0 24 24" />
        <icon name="copy-plus" viewBox="0 0 24 24" />
        <icon name="alert-triangle" viewBox="0 0 24 24" />
        <icon name="check-circle-2" viewBox="0 0 24 24" />
        <icon name="hourglass" viewBox="0 0 24 24" />
        <icon name="calendar-clock" viewBox="0 0 24 24" />
        <icon name="list-plus" viewBox="0 0 24 24" />
        <icon name="git-commit-vertical" viewBox="0 0 24 24" />
        <icon name="arrow-up-down" viewBox="0 0 24 24" />
        <icon name="pencil" viewBox="0 0 24 24" />
        <icon name="trash-2" viewBox="0 0 24 24" />
        <icon name="briefcase" viewBox="0 0 24 24" />
        <icon name="check" viewBox="0 0 24 24" />
